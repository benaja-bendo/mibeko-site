---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Vos droits, à portée de main",
  text = "Cherchez un texte officiel, lisez nos guides en français clair, ou emportez tout le droit congolais dans votre poche avec l'application mobile.",
} = Astro.props;

// Lien de l'app Android (identique à /produits).
const playStoreUrl = 'https://play.google.com/store/apps/details?id=cg.mibeko.app';
---

<section class="py-24 md:py-32 relative overflow-hidden bg-background">
  <!-- Dynamic Gradient Background -->
  <div class="absolute inset-4 md:inset-8 bg-primary rounded-3xl overflow-hidden shadow-2xl">
    <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-10 mix-blend-overlay"></div>
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-secondary/20 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-tertiary/20 rounded-full blur-[80px] -translate-x-1/3 translate-y-1/3 pointer-events-none"></div>
  </div>

  <div class="max-w-[800px] mx-auto px-8 sm:px-12 lg:px-16 text-center relative z-10 py-16 md:py-20 text-on-primary">
    <div class="animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl lg:text-[52px] font-bold tracking-tight leading-tight mb-6">
        {title}
      </h2>
      <p class="text-inverse-primary text-xl font-serif leading-relaxed mb-12 max-w-2xl mx-auto">
        {text}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/textes" class="inline-flex items-center justify-center gap-2 h-14 px-8 bg-on-primary text-primary font-bold rounded-xl hover:bg-surface-container-low transition-all duration-300 hover:scale-105 hover:shadow-xl w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" x2="16.65" y1="21" y2="16.65"></line></svg>
          Chercher un texte
        </a>
        <a href="/ressources" class="inline-flex items-center justify-center h-14 px-8 border-2 border-on-primary/30 text-on-primary font-bold rounded-xl hover:bg-on-primary/10 transition-all duration-300 w-full sm:w-auto">
          Lire les guides
        </a>
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 h-14 px-8 border-2 border-on-primary/30 text-on-primary font-bold rounded-xl hover:bg-on-primary/10 transition-all duration-300 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"/></svg>
          Télécharger l'app
        </a>
      </div>
    </div>
  </div>
</section>