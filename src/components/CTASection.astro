---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Revenez quand vous en avez besoin',
  text = "Installez l'application pour retrouver vos textes hors connexion, suivre les mises à jour du Journal officiel et garder une longueur d'avance sur vos démarches.",
} = Astro.props;
---

<section class="py-24 md:py-32 relative overflow-hidden bg-background">
  <!-- Aplat institutionnel : le filet et la teinte portent la hiérarchie. -->
  <div class="absolute inset-4 md:inset-8 bg-primary rounded-lg overflow-hidden">
  </div>

  <div class="max-w-[800px] mx-auto px-8 sm:px-12 lg:px-16 text-center relative z-10 py-16 md:py-20 text-on-primary">
    <div class="animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl lg:text-[52px] font-bold tracking-tight leading-tight mb-6">
        {title}
      </h2>
      <p class="text-inverse-primary text-xl font-serif leading-relaxed mb-12 max-w-2xl mx-auto">
        {text}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/textes" class="inline-flex items-center justify-center gap-2 h-14 px-8 bg-on-primary text-primary font-bold rounded-lg hover:bg-surface-container-low transition-all duration-300 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" x2="16.65" y1="21" y2="16.65"></line></svg>
          Chercher un texte
        </a>
        <a href="/guides" class="inline-flex items-center justify-center h-14 px-8 border-2 border-on-primary/30 text-on-primary font-bold rounded-lg hover:bg-on-primary/10 transition-all duration-300 w-full sm:w-auto">
          Lire les guides
        </a>
        <a href="/application" class="inline-flex items-center justify-center gap-2 h-14 px-8 border-2 border-on-primary/30 text-on-primary font-bold rounded-lg hover:bg-on-primary/10 transition-all duration-300 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path></svg>
          Télécharger l'app
        </a>
      </div>
    </div>
  </div>
</section>
