---
/**
 * Bloc d'accueil de l'Assistant Mibeko.
 *
 * Il porte un contenu réel — une vraie question et les articles publiés qui y
 * répondent — et non une affirmation sur Mibeko : c'est la condition posée en
 * tête de `index.astro` pour qu'un bloc ait sa place sur l'accueil. Il est
 * placé sous le champ de recherche du hero, jamais au-dessus (charte v2, loi 2).
 *
 * DEUX COLONNES, DEUX RÔLES (27/08/2026). À gauche, l'écran de l'application
 * qui se joue : c'est la **démonstration**, elle bouge, elle montre l'Assistant
 * en marche. À droite, les articles qu'il cite, en **liens réels** vers le fonds
 * publié de ce site : c'est la **preuve**, elle ne bouge pas, on clique dessus.
 * La séparation est volontaire — une animation ne prouve rien, un lien qui
 * répond 200 prouve quelque chose (loi 1). Et l'offre vient en dernier, une fois
 * les deux administrées (loi 2).
 *
 * 07/09/2026 : l'invitation ne renvoie plus « à l'espace professionnel ».
 * L'Assistant est ouvert à tout compte et différencié par quota, jamais par
 * rôle (mibeko-dashboard#76, mibeko-front#7 puis #24) — le dire autrement
 * vendait un mur qui n'existe plus et écartait le public réellement mesuré,
 * étudiants et citoyens. Le mot « gratuit » est porté par le bouton parce
 * qu'un visiteur ne devine pas qu'un compte ne se paie pas ; le nombre de
 * questions n'y figure pas, il se règle en base par palier
 * (`AiQuotaTierSetting`) et un chiffre en dur ici mentirait au prochain
 * réglage.
 */
import AssistantConversation from './AssistantConversation.astro';
import { featuredDemo } from '../data/assistant-demos';
import { UMAMI_EVENTS } from '../lib/analytics';
import { registerUrl } from '../lib/appLinks';
---

<section class="py-16 md:py-20 border-t border-surface-variant/50">
	<div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl mb-10">
			<p class="text-sm font-semibold uppercase tracking-wider text-secondary mb-2">Assistant Mibeko</p>
			<h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-3">Une question, et l'article qui y répond</h2>
			<p class="text-on-surface-variant font-serif leading-relaxed">
				L'assistant cherche dans les textes publiés sur ce site et cite l'article exact dont vient sa
				réponse. Vous l'ouvrez, et vous vérifiez.
			</p>
		</div>

		<div class="grid gap-10 lg:grid-cols-[300px_1fr] lg:gap-12 lg:items-start">
			<AssistantConversation demo={featuredDemo} />

			<div>
				<p class="text-xs font-semibold uppercase tracking-wider text-on-surface-muted mb-4">
					Les articles cités, publiés sur ce site
				</p>
				<ul class="flex flex-col gap-4 mb-8">
					{featuredDemo.sources.map((source) => (
						<li>
							<a
								href={source.href}
								class="inline-flex items-start gap-2 min-h-[24px] text-sm font-semibold text-primary hover:underline"
							>
								<span class="text-secondary shrink-0">[{source.marker}]</span>
								<span>{source.label}</span>
							</a>
						</li>
					))}
				</ul>

				<div class="border-t border-surface-variant pt-6">
					<p class="text-sm text-on-surface-variant mb-4">
						Lire les textes reste libre et sans compte. Pour poser vos propres questions, créez un
						compte gratuit : l'Assistant s'ouvre à tous, sur le web comme dans l'application mobile.
					</p>
					<div class="flex flex-col sm:flex-row gap-3">
						<a
							href={registerUrl('assistant')}
							target="_blank"
							rel="noopener noreferrer"
							data-umami-event={UMAMI_EVENTS.compteCreer}
							class="inline-flex items-center justify-center h-11 px-6 bg-primary text-on-primary text-sm font-semibold rounded-lg hover:bg-primary-container transition-colors"
						>
							Créer un compte gratuit
						</a>
						<a
							href="/assistant"
							class="inline-flex items-center justify-center h-11 px-6 border border-outline-variant/70 text-on-surface text-sm font-semibold rounded-lg hover:bg-surface-container transition-colors"
						>
							Voir les trois démonstrations
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
