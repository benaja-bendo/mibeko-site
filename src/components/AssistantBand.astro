---
/**
 * Bloc d'accueil de l'Assistant Mibeko.
 *
 * Il porte un contenu réel — une vraie question et les articles publiés qui y
 * répondent — et non une affirmation sur Mibeko : c'est la condition posée en
 * tête de `index.astro` pour qu'un bloc ait sa place sur l'accueil. Il est
 * placé sous le champ de recherche du hero, jamais au-dessus (charte v2, loi 2).
 */
import AssistantDemo from './AssistantDemo.astro';
import { featuredDemo } from '../data/assistant-demos';
---

<section class="py-16 md:py-20 border-t border-surface-variant/50">
	<div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl mb-8">
			<p class="text-sm font-semibold uppercase tracking-wider text-secondary mb-2">Assistant Mibeko</p>
			<h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-3">Une question, et l'article qui y répond</h2>
			<p class="text-on-surface-variant font-serif leading-relaxed">
				L'assistant cherche dans les textes publiés sur ce site et cite l'article exact dont vient sa
				réponse. Vous l'ouvrez, et vous vérifiez.
			</p>
		</div>

		<AssistantDemo demo={featuredDemo} compact />

		<p class="mt-6">
			<a href="/assistant" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
				Voir les trois démonstrations
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
			</a>
		</p>
	</div>
</section>
