---
import { documentPath, type EssentialDocument } from '../lib/api';
import { publicTypeLabel } from '../lib/legalMetadata';

interface Props {
  documents: EssentialDocument[];
  /** Surchargé sur /textes (mibeko-site#26) : la page elle-même, pas un renvoi vers elle. */
  moreHref?: string;
  moreLabel?: string;
}
const { documents, moreHref = '/textes', moreLabel = 'Parcourir tout le fonds' } = Astro.props;
---

<section class="py-16 md:py-20 bg-background border-t border-surface-variant/50">
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10">
      <p class="text-sm font-semibold uppercase tracking-wider text-secondary mb-2">Le fonds juridique</p>
      <h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight">Entrer dans le fonds</h2>
      {/* Ce que disait la bande « Notre engagement », retirée de l'accueil
          (mibeko-site#96) : la source, en une ligne, là où l'on entre dans le fonds. */}
      <p class="mt-3 text-on-surface-variant font-serif leading-relaxed">
        Chaque texte vient d'une source officielle&nbsp;: le Secrétariat général du Gouvernement (sgg.cg) ou l'OHADA (ohada.org).{' '}
        <a href="/methode" class="text-secondary font-semibold font-sans text-sm hover:underline whitespace-nowrap">Comment le fonds est constitué</a>
      </p>
    </div>

    {/* 2 colonnes dès le mobile (mibeko-site#28) : en 1 colonne, les 6 cartes
        empilées en pleine largeur repoussaient l'Assistant, plus bas sur la
        page, à ~4 défilements du haut. */}
    <ul class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
      {documents.map((doc) => (
        <li>
          <a href={documentPath(doc.slug)} class="group flex flex-col h-full p-3 sm:p-5 rounded-lg border border-surface-variant bg-surface-container-lowest hover:border-primary/40 transition-colors">
            <span class="inline-flex items-center self-start px-2.5 py-1 rounded bg-surface-container text-on-surface-variant text-xs font-semibold uppercase tracking-wider mb-3 group-hover:bg-secondary/10 group-hover:text-secondary transition-colors">
              {publicTypeLabel(doc.type_code, doc.type_name)}
            </span>
            <h3 class="casse-phrase text-base font-bold text-on-surface group-hover:text-primary transition-colors leading-snug mb-2">{doc.title}</h3>
            {doc.articles_count > 0 && (
              <p class="mt-auto text-xs text-on-surface-muted">{doc.articles_count} article{doc.articles_count > 1 ? 's' : ''}</p>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8">
      <a href={moreHref} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
        {moreLabel}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>
