---
/**
 * Encart « Canal WhatsApp » — affiché UNIQUEMENT si `PUBLIC_WHATSAPP_CHANNEL_URL`
 * est défini (variable publique, lue au build/SSR). Tant que le canal n'existe
 * pas (userAction : le créer et fournir l'URL), rien n'est rendu.
 *
 * Props : variant 'light' (fond clair) ou 'onPrimary' (fond foncé).
 */
interface Props {
  variant?: 'light' | 'onPrimary';
}

const { variant = 'light' } = Astro.props;
const channelUrl = import.meta.env.PUBLIC_WHATSAPP_CHANNEL_URL as string | undefined;
const onPrimary = variant === 'onPrimary';
---

{channelUrl && (
  <a
    href={channelUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'group inline-flex items-center gap-3 rounded-xl px-4 py-3 border transition-colors',
      onPrimary
        ? 'border-on-primary/25 bg-on-primary/10 text-on-primary hover:bg-on-primary/15'
        : 'border-surface-variant bg-surface-container-lowest text-on-surface hover:border-primary/40',
    ]}
  >
    <span class:list={['inline-flex items-center justify-center w-10 h-10 rounded-full shrink-0', onPrimary ? 'bg-on-primary/15' : 'bg-primary/10 text-primary']}>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
    </span>
    <span class="flex flex-col">
      <span class:list={['font-semibold', onPrimary ? 'text-on-primary' : 'text-on-surface']}>Suivez-nous sur WhatsApp</span>
      <span class:list={['text-sm', onPrimary ? 'text-inverse-primary' : 'text-on-surface-variant']}>Les nouveaux textes et démarches, directement sur votre téléphone.</span>
    </span>
  </a>
)}
