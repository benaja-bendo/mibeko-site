---
// Le fonds est le produit : la recherche vit dans l'en-tête comme un champ,
// pas une icône. Méthode et Nouveautés restent accessibles depuis le pied de
// page et les pages de contenu — ce sont des destinations de second contact,
// pas des portes d'entrée.
//
// Le menu nomme ce qu'on peut FAIRE ici, pas ce que Mibeko est : lire le
// fonds, comprendre une situation, poser une question, emporter le tout.
// « Assistant » y est entré parce que la page existait sans être atteignable
// autrement qu'en déroulant l'accueil jusqu'au sixième écran — c'est pourtant
// ce que les visiteurs viennent chercher.
//
// « Professionnels » a quitté la barre : il y était la SEULE porte vers un
// compte, si bien qu'un étudiant ou un citoyen — le public réellement mesuré —
// devait se déclarer professionnel pour créer le sien. La porte d'entrée est
// désormais le compte, ouvert à tous et gratuit.
//
// Le menu « Outils » (SITE-011) regroupe ce qu'on fait avec Mibeko au-delà de
// la lecture : l'application, l'Assistant, et le travail sur ses dossiers,
// qui n'avait aucune entrée sur ordinateur. Pas de sous-marque (D-054) :
// chaque entrée se nomme par ce qu'on y fait, dit à qui elle sert et ce
// qu'elle coûte pour commencer. C'est un `<details>` : sans JavaScript, il
// s'ouvre et se ferme quand même.
import { UMAMI_EVENTS } from '../lib/analytics';
import { registerUrl, loginUrl } from '../lib/appLinks';

const navLinks = [
  { href: '/textes', label: 'Le fonds' },
  { href: '/guides', label: 'Guides' },
];

const ICONS = {
  application: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2"></rect><path d="M11 18.5h2"></path></svg>',
  assistant: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12Z"></path><path d="M9.5 9.5a2.5 2.5 0 0 1 4.9.7c0 1.7-2.4 2.1-2.4 3.3"></path><path d="M12 16.5h.01"></path></svg>',
  dossiers: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2h8.5A1.5 1.5 0 0 1 21 9.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5Z"></path><path d="M8 13.5h8"></path></svg>',
};

const tools = [
  {
    href: '/application',
    label: "L'application",
    description: 'Lire hors connexion et garder ses articles favoris.',
    meta: 'Gratuite · Android et iPhone',
    icon: ICONS.application,
    event: undefined,
  },
  {
    href: '/assistant',
    label: 'Assistant Mibeko',
    description: "Une question en français courant, l'article exact qui y répond.",
    meta: 'Avec un compte gratuit',
    icon: ICONS.assistant,
    event: undefined,
  },
  {
    href: '/professionnels',
    label: 'Travailler vos dossiers',
    description: 'Affaires, échéances et export, pour les avocats et les juristes.',
    meta: 'Gratuit pour commencer',
    icon: ICONS.dossiers,
    event: UMAMI_EVENTS.travaillerOffre,
  },
];

const REGISTER_URL = registerUrl();
const LOGIN_URL = loginUrl();

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
const query = Astro.url.pathname === '/textes' ? (Astro.url.searchParams.get('q') ?? '') : '';
const toolsActive = tools.some((tool) => isActive(tool.href));
const CHEVRON = '<svg class="outils-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>';
---

<header class="sticky top-0 z-50 w-full bg-background border-b border-surface-variant/60" data-sticky-header>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8 h-16 lg:h-20 flex items-center gap-4 lg:gap-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0" aria-label="Mibeko — Accueil">
      <img src="/logo.svg" alt="" class="w-8 h-8 group-hover:opacity-90 transition-opacity" />
      <span class="font-sans font-bold text-xl text-primary tracking-tight">Mibeko</span>
    </a>

    <!-- Recherche (Desktop) : champ persistant, composant le plus important du site -->
    <form action="/textes" method="get" role="search" class="hidden lg:block flex-1 lg:max-w-[190px] xl:max-w-[260px]">
      <label for="header-search" class="sr-only">Rechercher un texte, un article ou un thème</label>
      <div class="flex items-center h-10 bg-surface-container-lowest border border-outline-variant/60 rounded-lg focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all pl-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant/60 shrink-0"><circle cx="11" cy="11" r="8"></circle><line x1="21" x2="16.65" y1="21" y2="16.65"></line></svg>
        <input id="header-search" name="q" type="search" value={query} placeholder="Rechercher…" data-search-suggest class="min-w-0 flex-1 bg-transparent border-none outline-none px-2.5 h-full text-sm text-on-surface placeholder:text-on-surface-variant/50" />
      </div>
    </form>

    <!-- Navigation (Desktop) -->
    <nav class="hidden lg:flex items-center gap-7 ml-auto" aria-label="Navigation principale">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            "text-sm font-medium transition-colors relative py-2 whitespace-nowrap",
            isActive(link.href) ? "text-primary" : "text-on-surface-variant hover:text-primary"
          ]}
        >
          {link.label}
          {isActive(link.href) && (
            <span class="absolute bottom-0 left-0 w-full h-[2px] bg-secondary rounded-t"></span>
          )}
        </a>
      ))}
      <details class="outils relative" data-outils>
        <summary
          class:list={[
            "list-none cursor-pointer select-none text-sm font-medium transition-colors relative py-2 whitespace-nowrap inline-flex items-center gap-1",
            toolsActive ? "text-primary" : "text-on-surface-variant hover:text-primary"
          ]}
        >
          Outils
          <Fragment set:html={CHEVRON} />
          {toolsActive && (
            <span class="absolute bottom-0 left-0 w-full h-[2px] bg-secondary rounded-t"></span>
          )}
        </summary>
        <div class="outils-panel absolute right-0 top-[calc(100%+37px)] z-10 w-[620px] max-w-[calc(100vw-2rem)] rounded-lg border border-outline-variant/70 bg-surface-container-lowest">
          <ul class="grid grid-cols-3">
            {tools.map((tool, index) => (
              <li class:list={[index > 0 && 'border-l border-surface-variant']}>
                <a
                  href={tool.href}
                  aria-current={isActive(tool.href) ? 'page' : undefined}
                  data-umami-event={tool.event}
                  class="flex h-full flex-col gap-1.5 p-5 transition-colors hover:bg-surface-container-low"
                >
                  <span class="mb-1 text-primary" set:html={tool.icon} />
                  <span class="text-[15px] font-semibold text-on-surface">{tool.label}</span>{' '}
                  <span class="text-[13px] leading-snug text-on-surface-variant">{tool.description}</span>{' '}
                  <span class="mt-auto pt-1 text-xs font-semibold text-secondary">{tool.meta}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="border-t border-surface-variant px-5 py-2.5 text-xs text-on-surface-muted">
            La lecture du fonds reste libre, sans compte.
          </p>
        </div>
      </details>
    </nav>

    <!-- Séparateur + entrée compte (Desktop) -->
    <div class="hidden lg:flex items-center gap-4 shrink-0">
      <span class="h-6 w-px bg-surface-variant" aria-hidden="true"></span>
      <a
        href={LOGIN_URL}
        class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap"
      >
        Se connecter
      </a>
      <a
        href={REGISTER_URL}
        data-umami-event={UMAMI_EVENTS.compteCreer}
        class="inline-flex items-center h-10 px-4 bg-primary text-on-primary text-sm font-semibold rounded-lg hover:bg-primary-container transition-colors whitespace-nowrap"
      >
        Créer un compte
      </a>
    </div>

    <!-- Mobile menu button (Hamburger) -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="lg:hidden ml-auto p-2 -mr-2 text-on-surface-variant hover:text-primary"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg data-icon="open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
      <svg data-icon="close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" x2="6" y1="6" y2="18"></line>
        <line x1="6" x2="18" y1="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-surface-variant/60 bg-background">
    <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-4 flex flex-col gap-1">
      <form action="/textes" method="get" role="search" class="mb-3">
        <label for="header-search-mobile" class="sr-only">Rechercher un texte, un article ou un thème</label>
        <div class="flex items-center h-11 bg-surface-container-lowest border border-outline-variant/60 rounded-lg focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all pl-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant/60 shrink-0"><circle cx="11" cy="11" r="8"></circle><line x1="21" x2="16.65" y1="21" y2="16.65"></line></svg>
          <input id="header-search-mobile" name="q" type="search" value={query} placeholder="Rechercher…" data-search-suggest class="min-w-0 flex-1 bg-transparent border-none outline-none px-2.5 h-full text-base text-on-surface placeholder:text-on-surface-variant/50" />
        </div>
      </form>
      <nav class="flex flex-col" aria-label="Navigation mobile">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              "py-3 text-base font-medium border-b border-surface-variant/40 transition-colors",
              isActive(link.href) ? "text-primary" : "text-on-surface-variant hover:text-primary"
            ]}
          >
            {link.label}
          </a>
        ))}
        <details class="outils-mobile border-b border-surface-variant/40" open={toolsActive}>
          <summary
            class:list={[
              "list-none cursor-pointer select-none flex items-center justify-between py-3 text-base font-medium transition-colors",
              toolsActive ? "text-primary" : "text-on-surface-variant hover:text-primary"
            ]}
          >
            Outils
            <Fragment set:html={CHEVRON} />
          </summary>
          <ul class="flex flex-col pb-2">
            {tools.map((tool) => (
              <li>
                <a
                  href={tool.href}
                  aria-current={isActive(tool.href) ? 'page' : undefined}
                  data-umami-event={tool.event}
                  class="flex gap-3 py-2.5 pl-1"
                >
                  <span class="mt-0.5 shrink-0 text-primary" set:html={tool.icon} />
                  <span class="min-w-0">
                    <span class="block text-[15px] font-semibold text-on-surface">{tool.label}</span>{' '}
                    <span class="block text-[13px] leading-snug text-on-surface-muted">{tool.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
      <div class="flex flex-col gap-2 pt-4">
        <a
          href={REGISTER_URL}
          data-umami-event={UMAMI_EVENTS.compteCreer}
          class="inline-flex items-center justify-center h-11 px-5 bg-primary text-on-primary text-sm font-semibold rounded-lg hover:bg-primary-container transition-colors"
        >
          Créer un compte gratuit
        </a>
        <a
          href={LOGIN_URL}
          class="inline-flex items-center justify-center h-11 px-5 border border-outline-variant/70 text-on-surface text-sm font-semibold rounded-lg hover:bg-surface-container transition-colors"
        >
          Se connecter
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /*
   * iOS Safari fait « fuir » le contenu déjà défilé dans la zone de
   * rebond (rubber-band scroll) : un en-tête `position: sticky` sans
   * calque de composition dédié se voit ré-afficher, en fantôme, le fil
   * d'Ariane et le titre qui viennent de défiler derrière lui. Le forcer
   * sur son propre calque GPU élimine ce fantôme (bug WebKit connu).
   */
  [data-sticky-header] {
    transform: translateZ(0);
  }
</style>

<style is:global>
  /* Menu « Outils » : mouvement selon SITE-010 (fondu et 6 px, 180 ms, sortie
     forte). La fermeture est instantanée, plus rapide que l'ouverture. */
  .outils > summary::-webkit-details-marker,
  .outils-mobile > summary::-webkit-details-marker { display: none; }
  .outils-chevron { transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1); }
  details[open] > summary .outils-chevron { transform: rotate(180deg); }
  .outils[open] .outils-panel,
  .outils-mobile[open] > ul {
    transition: opacity 180ms cubic-bezier(0.23, 1, 0.32, 1), transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @starting-style {
    .outils[open] .outils-panel { opacity: 0; transform: translateY(-6px); }
    .outils-mobile[open] > ul { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .outils-chevron,
    .outils[open] .outils-panel,
    .outils-mobile[open] > ul { transition: none; }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggle?.querySelector('[data-icon="open"]');
  const closeIcon = toggle?.querySelector('[data-icon="close"]');

  // Menu « Outils » (ordinateur) : Échap le ferme et rend le focus au bouton ;
  // un clic ou le focus hors du menu le ferme aussi.
  const outils = document.querySelector<HTMLDetailsElement>('[data-outils]');
  const fermerOutils = () => { if (outils) outils.open = false; };
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && outils?.open) {
      fermerOutils();
      outils.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (outils?.open && event.target instanceof Node && !outils.contains(event.target)) fermerOutils();
  });
  // Tabulation hors du menu. Un clic sur du texte du panneau ne donne le focus
  // à rien (`relatedTarget` nul) : c'est l'écouteur de clic qui tranche.
  outils?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !outils.contains(event.relatedTarget)) fermerOutils();
  });

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
    openIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
  });
</script>
