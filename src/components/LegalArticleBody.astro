---
/**
 * Corps d'un article juridique : texte officiel et tableaux.
 *
 * Un tableau du corpus arrive soit sous forme structurée (`tables`, posé par
 * l'ingestion), soit encore en HTML MinerU brut dans le texte pour les articles
 * ingérés avant la normalisation. `articleSegments` absorbe les deux : ce
 * composant ne rend jamais de HTML fourni par la donnée — il reconstruit la
 * table à partir de cellules de texte, seule forme sûre pour du contenu OCR.
 *
 * La mesure (charte § 5 : 18 px, interlignage 1,75, 68 caractères) est portée
 * par le SEGMENT DE TEXTE lui-même, pas par le conteneur appelant : posée plus
 * haut, elle se calcule dans la mauvaise police et à la mauvaise taille, et
 * elle écraserait les tableaux, qui eux doivent rester larges.
 *
 * Le texte hors tableau garde la mise en page du PDF source (une ligne du scan
 * = une ligne stockée). La charte (§ 8, « Corps d'article ») demande que ces
 * retours à la ligne soient supprimés à l'affichage : `reflowLegalText` les
 * regroupe en paragraphes et en listes sans modifier un seul caractère du
 * texte — voir `lib/legalTextFlow.ts`.
 */
import { articleSegments, type ApiTable } from '../lib/tables';
import { reflowLegalText } from '../lib/legalTextFlow';

interface Props {
  content: string | null | undefined;
  tables?: ApiTable[] | null;
}

const { content, tables } = Astro.props;
const segments = articleSegments(content, tables);

/** Cellule numérique (montant, quantité) : alignée à droite, chiffres tabulaires. */
const isNumeric = (cell: string) => /^[\d.,\s]*\d[\d.,\s]*\s*(%|FCFA|XAF)?$/i.test(cell.trim());
---

{segments.length === 0 ? (
  <p class="text-on-surface-variant italic">Le texte de cet article n'est pas encore disponible.</p>
) : (
  segments.map((segment) =>
    segment.kind === 'text' ? (
      <div class="font-serif text-on-surface text-base sm:text-lg leading-[1.75] break-words space-y-4 max-w-[68ch]">
        {reflowLegalText(segment.text).map((block) =>
          block.kind === 'paragraph' ? (
            <p>{block.text}</p>
          ) : (
            <ul class="list-none pl-0 space-y-2">
              {block.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-on-surface-variant shrink-0" aria-hidden="true">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          ),
        )}
      </div>
    ) : (
      <figure class="my-7 first:mt-0">
        {segment.table.caption && (
          <figcaption class="mb-2 text-sm font-semibold text-on-surface font-sans">
            {segment.table.caption}
          </figcaption>
        )}
        <div
          class="overflow-x-auto rounded-lg border border-surface-variant bg-surface-container-lowest"
          tabindex="0"
          role="region"
          aria-label={segment.table.caption ?? 'Tableau du texte officiel'}
        >
          <table class="w-full border-collapse text-sm font-sans">
            {segment.table.headers.length > 0 && (
              <thead>
                <tr class="bg-surface-container">
                  {segment.table.headers.map((header) => (
                    <th
                      scope="col"
                      class="px-3 py-2.5 text-left align-bottom font-semibold text-on-surface border-b border-surface-variant whitespace-nowrap"
                    >
                      {header}
                    </th>
                  ))}
                </tr>
              </thead>
            )}
            <tbody>
              {segment.table.rows.map((row) => (
                <tr class="border-b border-surface-variant/60 last:border-b-0">
                  {row.map((cell) => (
                    <td
                      class:list={[
                        'px-3 py-2 align-top text-on-surface-variant',
                        isNumeric(cell) ? 'text-right tabular-nums whitespace-nowrap' : '',
                      ]}
                    >
                      {cell}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>
    ),
  )
)}
