---
import NewsletterForm from './NewsletterForm.astro';

const year = new Date().getFullYear();
// Rendu seulement si le canal existe (userAction : le créer et fournir l'URL).
const whatsappChannelUrl = import.meta.env.PUBLIC_WHATSAPP_CHANNEL_URL as string | undefined;

const columns = [
  {
    title: 'Accéder au droit',
    links: [
      { href: '/textes', label: 'Textes officiels' },
      { href: '/situations', label: 'Par situation' },
      // Fusion des anciens /ressources et /demarches (18/08/2026) : une
      // seule entrée, plutôt que deux pour huit contenus au total.
      { href: '/guides', label: 'Guides et démarches' },
      { href: '/textes', label: 'Rechercher' },
    ],
  },
  {
    title: 'Mibeko',
    links: [
      { href: '/textes/nouveautes', label: 'Nouveautés du fonds' },
      { href: '/methode', label: 'Notre méthode' },
      { href: '/application', label: "L'application" },
      { href: '/professionnels', label: 'Professionnels' },
      { href: 'https://app.mibeko.fr/auth/register', label: 'Créer un compte', external: true },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Légal',
    links: [
      { href: '/mentions-legales', label: 'Mentions légales' },
      { href: '/cgu', label: "Conditions d'utilisation" },
      { href: '/confidentialite', label: 'Confidentialité' },
    ],
  },
];
---

<footer class="bg-primary text-on-primary pt-12 md:pt-16 mt-auto">
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 md:gap-12">
      <!-- Brand + newsletter -->
      <div class="col-span-2 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2 w-fit">
          <img src="/logo.svg" alt="" class="w-6 h-6" />
          <span class="font-sans font-bold text-lg tracking-tight">Mibeko</span>
        </a>
        <p class="text-inverse-primary text-sm leading-relaxed max-w-xs">
          Le droit congolais, clair et à portée de main. Textes officiels, guides et démarches — pour tous les citoyens.
        </p>

        <div class="mt-2 max-w-sm">
          <NewsletterForm
            source="footer"
            variant="onPrimary"
            title="Restez informé"
            description="Les nouveaux textes et guides, une fois par mois. Rien d'autre."
            compact
          />
        </div>

        <div class="flex gap-3 mt-2">
          <a href="mailto:contact@mibeko.fr" aria-label="E-mail" class="w-9 h-9 rounded-lg border border-inverse-primary/40 flex items-center justify-center text-inverse-primary hover:text-white hover:border-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61589502440247" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-9 h-9 rounded-lg border border-inverse-primary/40 flex items-center justify-center text-inverse-primary hover:text-white hover:border-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"></path></svg>
          </a>
          <a href="https://www.linkedin.com/company/mibeko-app" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-9 h-9 rounded-lg border border-inverse-primary/40 flex items-center justify-center text-inverse-primary hover:text-white hover:border-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          </a>
          <a href="https://www.tiktok.com/@mibekoai" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="w-9 h-9 rounded-lg border border-inverse-primary/40 flex items-center justify-center text-inverse-primary hover:text-white hover:border-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
          </a>
          {whatsappChannelUrl && (
            <a href={whatsappChannelUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-9 h-9 rounded-lg border border-inverse-primary/40 flex items-center justify-center text-inverse-primary hover:text-white hover:border-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <div class="flex flex-col gap-4">
          <h3 class="font-sans font-semibold text-sm">{col.title}</h3>
          <ul class="flex flex-col gap-3">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={'external' in link ? '_blank' : undefined}
                  rel={'external' in link ? 'noopener noreferrer' : undefined}
                  class="inline-flex items-center min-h-[24px] text-inverse-primary hover:text-white text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-6 pb-8 border-t border-inverse-primary/20 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
      <p class="text-inverse-primary text-xs">
        © {year} Mibeko. Tous droits réservés.
      </p>
      <p class="text-inverse-primary/80 text-xs sm:max-w-xl sm:text-right">
        Mibeko est un service privé et indépendant. Il n’émane pas de l’État congolais. Seule la publication au Journal officiel fait foi.
      </p>
    </div>
  </div>
</footer>
