---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import EssentialTexts from '../components/EssentialTexts.astro';
import RecentAdditions from '../components/RecentAdditions.astro';
import GuidesBand from '../components/GuidesBand.astro';
import WhyMibeko from '../components/WhyMibeko.astro';
import AssistantBand from '../components/AssistantBand.astro';
import AppExit from '../components/AppExit.astro';
import Footer from '../components/Footer.astro';
import { fetchLibraryFundStats, fetchPublishedDocuments, type LibraryFundStats, type DocumentMeta } from '../lib/api';
import { typeSignificanceRank } from '../lib/legalMetadata';
import { getCollection } from 'astro:content';

// Deux appels réseau indépendants, en parallèle : chacun dégrade seul (une
// panne de l'un n'empêche pas l'autre bloc de s'afficher).
const [fundStatsResult, recentResult] = await Promise.allSettled([
	fetchLibraryFundStats(),
	// 20 candidats plutôt que 5 : le bloc affiche les plus SIGNIFICATIFS parmi
	// les derniers intégrés, pas les 5 derniers par ordre d'insertion — sur un
	// fonds dominé en volume par des arrêtés administratifs, ces deux idées
	// divergent presque toujours (mibeko-site#32).
	fetchPublishedDocuments({ sort: '-created_at', perPage: 20 }),
]);

const fundStats: LibraryFundStats | null = fundStatsResult.status === 'fulfilled' ? fundStatsResult.value : null;
const recentCandidates: DocumentMeta[] = recentResult.status === 'fulfilled' ? recentResult.value.items : [];

// Un texte fondamental d'abord, un arrêté en dernier ; à rang égal, l'ordre
// d'intégration (le tri de l'API) est conservé — `Array#sort` est stable.
const recentSignificant = [...recentCandidates]
	.sort((a, b) => typeSignificanceRank(a.type_code) - typeSignificanceRank(b.type_code))
	.slice(0, 5);

// « Le fonds vit » ne tient pas si la dernière intégration remonte à plus de
// deux semaines : le bloc s'efface plutôt que de contredire son propre titre.
const FRESHNESS_THRESHOLD_DAYS = 14;
const mostRecentCreatedAt = recentCandidates[0]?.created_at ? new Date(recentCandidates[0].created_at).getTime() : null;
const isFreshEnough = mostRecentCreatedAt !== null
	&& (Date.now() - mostRecentCreatedAt) / 86_400_000 <= FRESHNESS_THRESHOLD_DAYS;

const recentDocuments: DocumentMeta[] = isFreshEnough ? recentSignificant : [];

const guides = (await getCollection('guides', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
	.slice(0, 4);
---

<Layout title="Mibeko — Le droit congolais, clair et à portée de main">
	<Header />
	<main id="main" class="flex-grow">
		{/* Chaque bloc porte un contenu réel — un texte, une nouveauté, un guide —
		    au lieu d'une affirmation sur Mibeko. Voir docs/produit/positionnement-site-app.md
		    et la charte visuelle v2 (§ 6, densité) pour la doctrine. */}
		{/* ORDRE DE LA PAGE (07/09/2026) — il répond à « qu'est-ce que je peux
		    faire ici ? », dans l'ordre où un visiteur se pose la question :
		    chercher (hero), lire (le fonds), demander (l'Assistant), vérifier
		    (l'engagement), comprendre (les guides), constater que le fonds vit
		    (les nouveautés), l'emporter (l'app).

		    L'Assistant est remonté du sixième au troisième rang : c'est le seul
		    bloc qui montre ce que le produit fait de plus que consulter un PDF,
		    et le seul qui mène à un compte — il était servi après un bloc de
		    nouveautés qui affiche des arrêtés de 1959, ce qui faisait dépendre
		    la découverte du produit de la patience du visiteur. Les nouveautés
		    descendent d'autant : elles prouvent que le fonds vit, ce qui est un
		    argument de retour, pas d'accueil. */}
		<HomeHero stats={fundStats} />
		{fundStats && fundStats.essentialDocuments.length > 0 && (
			<EssentialTexts documents={fundStats.essentialDocuments} />
		)}
		<AssistantBand />
		<WhyMibeko />
		{guides.length > 0 && <GuidesBand guides={guides} />}
		{recentDocuments.length > 0 && <RecentAdditions documents={recentDocuments} />}
		<AppExit />
	</main>
	<Footer />
</Layout>
