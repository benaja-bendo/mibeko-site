---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import EssentialTexts from '../components/EssentialTexts.astro';
import RecentAdditions from '../components/RecentAdditions.astro';
import GuidesBand from '../components/GuidesBand.astro';
import WhyMibeko from '../components/WhyMibeko.astro';
import AppExit from '../components/AppExit.astro';
import Footer from '../components/Footer.astro';
import { fetchLibraryFundStats, fetchPublishedDocuments, type LibraryFundStats, type DocumentMeta } from '../lib/api';
import { getCollection } from 'astro:content';

// Deux appels réseau indépendants, en parallèle : chacun dégrade seul (une
// panne de l'un n'empêche pas l'autre bloc de s'afficher).
const [fundStatsResult, recentResult] = await Promise.allSettled([
	fetchLibraryFundStats(),
	fetchPublishedDocuments({ sort: '-created_at', perPage: 5 }),
]);

const fundStats: LibraryFundStats | null = fundStatsResult.status === 'fulfilled' ? fundStatsResult.value : null;
const recentDocuments: DocumentMeta[] = recentResult.status === 'fulfilled' ? recentResult.value.items : [];

const guides = (await getCollection('guides', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
	.slice(0, 4);
---

<Layout title="Mibeko — Le droit congolais, clair et à portée de main">
	<Header />
	<main id="main" class="flex-grow">
		{/* Chaque bloc porte un contenu réel — un texte, une nouveauté, un guide —
		    au lieu d'une affirmation sur Mibeko. Voir docs/produit/positionnement-site-app.md
		    et la charte visuelle v2 (§ 6, densité) pour la doctrine. */}
		<HomeHero stats={fundStats} />
		{fundStats && fundStats.essentialDocuments.length > 0 && (
			<EssentialTexts documents={fundStats.essentialDocuments} />
		)}
		{recentDocuments.length > 0 && <RecentAdditions documents={recentDocuments} />}
		{guides.length > 0 && <GuidesBand guides={guides} />}
		<WhyMibeko />
		<AppExit />
	</main>
	<Footer />
</Layout>
