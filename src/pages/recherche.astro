---
export const prerender = false;

// Fusion recherche + fonds (18/08/2026) : /recherche n'est plus une page,
// c'est un alias qui redirige vers /textes en conservant la requête. Une
// redirection de `astro.config.mjs` ne préserve pas la query string ; celle-ci
// le fait explicitement.
return Astro.redirect(`/textes${Astro.url.search}`, 301);
