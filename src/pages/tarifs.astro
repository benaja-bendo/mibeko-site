---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';

// Offre Gratuite (citoyen) vs Pro (professionnel). Les capacités listées sont
// RÉELLES (cf. /produits). Les PRIX sont des placeholders explicites — aucun
// tarif inventé (userAction : fournir les prix de lancement).
const freeFeatures = [
  'Consultation de tous les textes officiels (codes, lois, décrets, arrêtés)',
  'Lecture article par article, avec le PDF source',
  'Recherche plein-texte dans le fonds',
  'Guides en français clair et démarches pas à pas',
  'Parcours par situation (thèmes de vie)',
  'Application mobile Android et iPhone',
];

const proFeatures = [
  'Tout ce qui est inclus dans l’offre Gratuite',
  'Recherche avancée (lexicale + sémantique) sur tout le fonds',
  'Assistant IA sourcé, avec citations cliquables vers les articles',
  'Bibliothèque avancée et organisation par dossiers',
  'Suivi des échéances et rappels de délais',
  'Veille du Journal Officiel et export PDF',
];

const registerUrl = 'https://app.mibeko.fr/register';
---

<Layout
  title="Tarifs — Mibeko"
  description="Mibeko est gratuit pour consulter le droit congolais : textes officiels, guides et recherche. L'offre Pro ajoute l'assistant IA, la bibliothèque avancée et le suivi des dossiers pour les professionnels du droit."
>
  <Header />
  <main id="main" class="flex-grow bg-background">
    <PageHeader
      eyebrow="Tarifs"
      title="Gratuit pour tous. Puissant pour les pros."
      subtitle="Consulter le droit congolais est et restera gratuit. Les professionnels qui veulent aller plus vite disposent d'outils avancés."
    />

    <section class="pb-16 md:pb-24">
      <div class="max-w-[1000px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">

          <!-- Offre Gratuite (citoyen) -->
          <div class="flex flex-col rounded-3xl border border-surface-variant bg-surface-container-lowest p-8 md:p-10">
            <div class="mb-6">
              <div class="inline-flex items-center px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold tracking-wide uppercase mb-4">Pour les citoyens</div>
              <h2 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">Gratuit</h2>
              <p class="text-on-surface-variant">Accéder au droit, le comprendre et le suivre — sans compte, sans frais.</p>
            </div>
            <div class="mb-6">
              <span class="text-4xl font-bold text-on-surface">0 FCFA</span>
              <span class="text-on-surface-variant"> / toujours</span>
            </div>
            <ul class="flex flex-col gap-3 mb-8 flex-grow">
              {freeFeatures.map((f) => (
                <li class="flex items-start gap-3 text-sm text-on-surface-variant">
                  <svg class="text-primary shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a href="/textes" class="inline-flex items-center justify-center h-12 px-6 bg-primary text-on-primary font-semibold rounded-xl hover:bg-primary-container transition-colors mt-auto">
              Commencer à explorer
            </a>
          </div>

          <!-- Offre Pro (professionnel) -->
          <div class="flex flex-col rounded-3xl border-2 border-secondary/40 bg-surface-container-lowest p-8 md:p-10 relative">
            <span class="absolute -top-3 left-8 inline-flex items-center px-3 py-1 rounded-full bg-secondary text-on-secondary text-xs font-bold uppercase tracking-wide">Recommandé aux pros</span>
            <div class="mb-6">
              <div class="inline-flex items-center px-3 py-1 rounded-full bg-secondary/10 text-secondary text-xs font-semibold tracking-wide uppercase mb-4">Pour les professionnels</div>
              <h2 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">Pro</h2>
              <p class="text-on-surface-variant">Le poste de travail des avocats, notaires et juristes d'entreprise.</p>
            </div>
            <div class="mb-6">
              {/* PLACEHOLDER PRIX — userAction : remplacer par le tarif de lancement réel. */}
              <span class="text-2xl font-bold text-on-surface">Tarification de lancement</span>
              <p class="text-sm text-on-surface-variant mt-1">Nous contacter pour connaître les conditions.</p>
            </div>
            <ul class="flex flex-col gap-3 mb-8 flex-grow">
              {proFeatures.map((f) => (
                <li class="flex items-start gap-3 text-sm text-on-surface-variant">
                  <svg class="text-secondary shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="flex flex-col sm:flex-row gap-3 mt-auto">
              <a href={registerUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center h-12 px-6 bg-secondary text-on-secondary font-semibold rounded-xl hover:opacity-90 transition-opacity sm:flex-1">
                Créer un compte Pro
              </a>
              <a href="/contact" class="inline-flex items-center justify-center h-12 px-6 border border-outline-variant/70 text-on-surface font-semibold rounded-xl hover:bg-surface-container transition-colors sm:flex-1">
                Nous contacter
              </a>
            </div>
          </div>

        </div>

        <p class="mt-8 text-center text-sm text-on-surface-variant">
          Les textes officiels restent consultables librement par tous, sans compte.
          <a href="/methode" class="text-primary font-semibold hover:underline">Découvrez d'où viennent nos textes</a>.
        </p>
      </div>
    </section>

    <!-- FAQ courte, factuelle -->
    <section class="pb-20 md:pb-28">
      <div class="max-w-[760px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-on-surface mb-6">Questions fréquentes</h2>
        <div class="flex flex-col gap-4">
          <details class="group rounded-2xl border border-surface-variant bg-surface-container-lowest p-5">
            <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-on-surface">
              La consultation des textes est-elle vraiment gratuite ?
              <svg class="text-on-surface-variant transition-transform group-open:rotate-180 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <p class="mt-3 text-sm text-on-surface-variant leading-relaxed">Oui. Lire les textes officiels, les guides et utiliser la recherche est gratuit, sans compte. L'offre Pro concerne les outils de travail avancés destinés aux professionnels.</p>
          </details>
          <details class="group rounded-2xl border border-surface-variant bg-surface-container-lowest p-5">
            <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-on-surface">
              Comment obtenir l'offre Pro ?
              <svg class="text-on-surface-variant transition-transform group-open:rotate-180 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <p class="mt-3 text-sm text-on-surface-variant leading-relaxed">Créez un compte sur l'espace professionnel, ou contactez-nous pour connaître les conditions de la tarification de lancement.</p>
          </details>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
