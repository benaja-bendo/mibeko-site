---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import AssistantDemo from '../components/AssistantDemo.astro';
import Footer from '../components/Footer.astro';
import { assistantDemos } from '../data/assistant-demos';
import { UMAMI_EVENTS } from '../lib/analytics';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=cg.mibeko.app';
const appStoreUrl = 'https://apps.apple.com/app/id6768865781';

// Ce que l'assistant fait réellement — chaque ligne est adossée à une règle
// effectivement appliquée côté serveur, pas à une intention commerciale.
// Voir `app/Ai/Agents/MibekoIA.php` (prompt système) et
// `app/Ai/AssistantChatService.php` (vérification des citations).
const guarantees = [
	{
		title: 'Il ne répond qu’à partir du fonds',
		body: "L'assistant cherche dans les textes publiés par Mibeko et compose sa réponse à partir des articles qu'il en retire. Quand il ne trouve pas, il le dit plutôt que de combler le vide.",
	},
	{
		title: 'Congo-Brazzaville et OHADA, exclusivement',
		body: "« Code pénal », « code du travail », « constitution » désignent toujours le texte congolais. L'assistant ne répond jamais avec le droit français ou celui d'un autre pays.",
	},
	{
		title: 'Chaque affirmation porte son article',
		body: "Les réponses sont numérotées et renvoient à l'article exact dont elles proviennent. Vous ouvrez le texte officiel et vous vérifiez — c'est le seul contrôle qui vaille.",
	},
	{
		title: 'Une citation sans source est retirée',
		body: "Un renvoi qui ne correspond à aucun article réellement retrouvé est supprimé de la réponse avant qu'elle vous parvienne. Ce n'est pas une consigne donnée au modèle : c'est un contrôle appliqué à sa sortie.",
	},
];
---

<Layout
	title="Assistant Mibeko — une réponse, et les articles qui la fondent"
	description="L'Assistant Mibeko répond aux questions juridiques à partir des textes officiels publiés du Congo-Brazzaville et de l'OHADA, et cite l'article exact derrière chaque affirmation. Démonstrations vérifiables."
>
	<Header />
	<main id="main" class="flex-grow bg-background">
		<PageHeader
			eyebrow="Assistant Mibeko"
			title="Une réponse, et les articles qui la fondent"
			subtitle="Poser une question de droit est facile. Savoir d'où vient la réponse l'est moins. L'Assistant Mibeko cherche dans les textes officiels publiés sur ce site, et vous donne l'article exact pour que vous puissiez vérifier."
		/>

		<section class="py-12 md:py-16">
			<div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
				<div class="max-w-2xl mb-10">
					<h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-3">Trois questions, et leurs sources</h2>
					<p class="text-on-surface-variant font-serif leading-relaxed">
						Les articles cités ci-dessous sont publiés sur ce site. Ouvrez-les : c'est ainsi qu'une réponse
						se contrôle.
					</p>
				</div>

				<div class="flex flex-col gap-6">
					{assistantDemos.map((demo) => <AssistantDemo demo={demo} />)}
				</div>
			</div>
		</section>

		<section class="py-12 md:py-16 bg-surface-container-low border-y border-surface-variant/50">
			<div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
				<p class="text-sm font-semibold uppercase tracking-wider text-secondary mb-2">Comment il répond</p>
				<h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-8">Quatre règles, appliquées à chaque réponse</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-8">
					{guarantees.map((g) => (
						<div class="pt-4 border-t-2 border-secondary/50">
							<h3 class="text-base font-bold text-on-surface mb-1.5">{g.title}</h3>
							<p class="text-sm text-on-surface-variant font-serif leading-relaxed">{g.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="py-12 md:py-16">
			<div class="max-w-[680px] mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-4">Ce qu'il ne fait pas</h2>
				<p class="font-serif text-on-surface-variant leading-relaxed mb-4">
					Les réponses de l'assistant sont <strong class="text-on-surface">générées automatiquement</strong>.
					Malgré le soin apporté à les ancrer dans les textes officiels, elles peuvent être incomplètes ou
					imprécises : vérifiez les articles cités avant toute décision. Elles constituent de l'information
					juridique, et ne remplacent pas l'avis d'un professionnel.
				</p>
				<p class="font-serif text-on-surface-variant leading-relaxed">
					L'assistant ne rédige pas vos actes et ne connaît pas votre dossier. Il ne couvre que les textes
					déjà publiés dans le fonds Mibeko&nbsp;: quand un texte manque, aucune réponse ne peut s'y appuyer.
				</p>
				<p class="mt-5 text-sm">
					<a href="/methode" class="text-secondary font-semibold hover:underline">Comment le fonds est constitué</a>
					<span class="text-on-surface-muted"> · </span>
					<a href="/cgu" class="text-secondary font-semibold hover:underline">Conditions d'utilisation</a>
				</p>
			</div>
		</section>

		<section class="py-16 md:py-20 bg-surface-container-low border-t border-surface-variant/50">
			<div class="max-w-[640px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<p class="text-xs font-semibold uppercase tracking-wider text-secondary mb-4">Où l'utiliser</p>
				<h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-4">L'assistant vit dans l'application et dans l'espace professionnel</h2>
				<p class="text-on-surface-variant text-base font-serif leading-relaxed mb-8">
					La lecture du fonds reste libre et sans compte sur ce site. Pour poser vos propres questions,
					l'assistant est disponible dans l'application mobile et dans l'espace professionnel.
				</p>
				<div class="flex flex-col sm:flex-row gap-3 justify-center">
					<a
						href="/application"
						class="inline-flex items-center justify-center h-12 px-8 bg-primary text-on-primary font-semibold rounded-lg hover:bg-primary-container transition-colors"
					>
						L'application mobile
					</a>
					<a
						href="/professionnels"
						class="inline-flex items-center justify-center h-12 px-8 border border-outline-variant/70 text-on-surface font-semibold rounded-lg hover:bg-surface-container transition-colors"
						data-umami-event={UMAMI_EVENTS.travaillerOffre}
					>
						L'espace professionnel
					</a>
				</div>
				<p class="mt-6 text-sm text-on-surface-muted">
					Disponible sur <a href={playStoreUrl} class="text-secondary font-semibold hover:underline" rel="noopener noreferrer" target="_blank">Google Play</a>{' '}
					et l'<a href={appStoreUrl} class="text-secondary font-semibold hover:underline" rel="noopener noreferrer" target="_blank">App Store</a>.
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
