---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DocumentOutline from '../../../components/DocumentOutline.astro';
import DocumentTools from '../../../components/DocumentTools.astro';
import DocumentSearchResults from '../../../components/DocumentSearchResults.astro';
import LegalStatusBanner from '../../../components/LegalStatusBanner.astro';
import SectionReader from '../../../components/SectionReader.astro';
import ReportIssue from '../../../components/ReportIssue.astro';
import OpenInAppBanner from '../../../components/OpenInAppBanner.astro';
import LegalDocumentEvidence from '../../../components/LegalDocumentEvidence.astro';
import {
  fetchPublicDocument,
  fetchDocumentSearch,
  buildTree,
  countStructureDivisions,
  documentPath,
  articlePath,
  pdfProxyUrl,
} from '../../../lib/api';
import { articleLeafLabel, documentLineLabel } from '../../../lib/sanitize';
import { documentTypeLabel, formatFrenchDate, formatSectionPath, isUnclassifiedType } from '../../../lib/legalMetadata';

const { doc } = Astro.params;

// Recherche À L'INTÉRIEUR du texte. Quand elle est active, la colonne centrale
// rend les résultats au lieu de la lecture : inutile de faire porter à l'API le
// texte d'une division que personne ne lira.
const rawQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const query = rawQuery.length >= 2 ? rawQuery : '';
const reportStatus = Astro.url.searchParams.get('signalement');

const payload = doc ? await fetchPublicDocument(doc, undefined, query ? undefined : 'first') : null;
const notFound = !payload;

if (notFound) {
  Astro.response.status = 404;
}

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const document = payload?.document;
const articles = payload?.articles ?? [];
const tree = buildTree(payload?.structure);
const sectionCount = countStructureDivisions(tree);
const section = payload?.section ?? null;
const hasPdf = Boolean(payload?.has_pdf);
const pdfUrl = document && hasPdf ? pdfProxyUrl(document.id) : null;
const pdfDownloadUrl = document && hasPdf ? pdfProxyUrl(document.id, { download: true }) : null;

const search = query && document ? await fetchDocumentSearch(document.id, query) : null;

/**
 * Le champ du sommaire est unique : il cherche dans le texte, mais on y tape
 * aussi un numéro d'article (« 1204 », « art. 5 », « Article 12 bis »). Le
 * moteur, lui, cherche dans le CONTENU — « 1204 » n'y trouverait que les
 * articles qui citent ce nombre, jamais l'article 1204 lui-même. On reconnaît
 * donc la référence côté serveur et on propose le saut direct en tête des
 * résultats. Sans cela, aucun accès par numéro ne survit à la coupure de
 * JavaScript sur un code de 2 826 articles.
 */
const asArticleRef = (value: string) =>
  value
    .replace(/^(?:art(?:icle)?s?\.?)\s*/i, '')
    .replace(/\s+/g, ' ')
    .trim()
    .toLocaleLowerCase('fr');

const wantedRef = query ? asArticleRef(rawQuery) : '';
const directArticle = wantedRef
  ? (articles.find((item) => asArticleRef(item.number) === wantedRef) ?? null)
  : null;

// Le sommaire marque et déplie la division RÉELLEMENT affichée. Quand l'API ne
// sert pas encore de division, la page ne montre aucun texte : marquer une
// division dans le sommaire prétendrait qu'on est en train de la lire.
const activeNumber = section?.articles[0]?.number;
const currentLabel = section ? formatSectionPath(section.path) || undefined : undefined;

const typeName = documentTypeLabel(document);

/**
 * Intitulé sur une ligne, pour tout ce qui ne dispose pas de deux lignes : la
 * balise `<title>`, la méta-description, le fil d'Ariane, le partage. Sur un
 * acte en abrégé, `titre_officiel` seul ne dit que « Décret n° 2025-240 du
 * 20 juin 2025. » — illisible pour un lecteur comme pour un moteur. Le H1 de
 * la page, lui, garde l'intitulé officiel SEUL : c'est lui qui fait foi.
 */
const intituleUneLigne = documentLineLabel(document?.titre_officiel, document?.libelle_descriptif);

const selfPath = document ? documentPath(document.slug) : '';
const selfUrl = selfPath ? new URL(selfPath, siteOrigin).href : '';

const scopeLabel: Record<string, string> = {
  national: 'National',
  ohada: 'OHADA',
  communautaire: 'Communautaire',
};

const signedDate = formatFrenchDate(document?.date_signature);
const publishedDate = formatFrenchDate(document?.date_publication);
const themes = document?.themes ?? [];

// Référence collable : ce qu'un juriste met dans ses conclusions. L'URL publique
// est déclarée en App Link / Universal Link, donc elle ouvre l'application chez
// qui l'a installée.
const reference = [
  document?.titre_officiel,
  publishedDate ? `publié le ${publishedDate}` : signedDate ? `signé le ${signedDate}` : null,
]
  .filter(Boolean)
  .join(', ') + ` — ${selfUrl}`;

const legislationLd = document
  ? {
      '@context': 'https://schema.org',
      '@type': 'Legislation',
      name: document.titre_officiel,
      legislationType: typeName,
      legislationJurisdiction: { '@type': 'AdministrativeArea', name: 'République du Congo' },
      inLanguage: 'fr',
      url: selfUrl,
      ...(document.reference_nor ? { legislationIdentifier: document.reference_nor } : {}),
      ...(document.date_publication ? { datePublished: document.date_publication } : {}),
    }
  : null;

const breadcrumbLd = document
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', siteOrigin).href },
        { '@type': 'ListItem', position: 2, name: 'Textes officiels', item: new URL('/textes', siteOrigin).href },
        { '@type': 'ListItem', position: 3, name: document.titre_officiel, item: selfUrl },
      ],
    }
  : null;

const jsonLd = [legislationLd, breadcrumbLd].filter(Boolean) as Record<string, unknown>[];

const btnPrimary = 'inline-flex items-center justify-center gap-2 h-11 px-5 rounded-lg bg-primary text-on-primary font-semibold text-sm hover:bg-primary-container transition-colors';
const btnGhost = 'inline-flex items-center justify-center gap-2 h-11 px-5 rounded-lg border border-surface-variant bg-surface-container-lowest text-on-surface font-semibold text-sm hover:border-primary/40 transition-colors';
---

<Layout
  title={notFound ? 'Texte introuvable — Mibeko' : `${intituleUneLigne} — Mibeko`}
  description={notFound
    ? "Ce texte n'est pas disponible dans le fonds Mibeko."
    : `${intituleUneLigne} — ${typeName} de la République du Congo. ${articles.length} articles, consultables librement sur Mibeko.`}
  ogType="article"
  canonical={selfUrl || undefined}
  jsonLd={jsonLd}
  appArgument={selfUrl || undefined}
  noindex={Boolean(query)}
>
  <Header />
  <main id="main" class="flex-grow bg-background">
    {notFound ? (
      <section class="max-w-[700px] mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-secondary mb-4">Erreur 404</p>
        <h1 class="text-3xl md:text-4xl font-bold text-on-surface mb-6">Ce texte est introuvable</h1>
        <a href="/textes" class="inline-flex items-center h-11 px-6 bg-primary text-on-primary font-semibold rounded hover:bg-primary-container transition-colors">
          Parcourir le fonds juridique
        </a>
      </section>
    ) : (
      <div class="mx-auto max-w-[1120px] xl:max-w-[1400px] px-4 sm:px-6 lg:px-8 xl:px-10 py-6 md:py-10">

        <nav aria-label="Fil d'Ariane" class="text-sm text-on-surface-variant mb-5 flex flex-wrap items-center gap-1.5 print:hidden">
          <a href="/" class="hover:text-primary transition-colors">Accueil</a>
          <span class="text-on-surface-muted">/</span>
          <a href="/textes" class="hover:text-primary transition-colors">Textes officiels</a>
          <span class="text-on-surface-muted">/</span>
          <span class="text-on-surface font-medium line-clamp-1">{intituleUneLigne}</span>
        </nav>

        <!-- Trois colonnes en très grand écran, deux en desktop, une en mobile.
             Le rail droit passe SOUS la colonne de texte en dessous de 1280 px
             (placement de grille explicite) : la mesure du texte ne rétrécit
             jamais pour lui faire de la place. -->
        <div class="grid gap-6 lg:gap-8 lg:grid-cols-[280px_minmax(0,1fr)] xl:grid-cols-[280px_minmax(0,1fr)_272px]">

          <!-- ─────────── Rail gauche : le sommaire ─────────── -->
          <aside class="order-2 lg:order-none min-w-0 lg:col-start-1 lg:row-start-1 lg:row-span-3 lg:self-start lg:sticky lg:top-24 print:hidden">
            <DocumentOutline
              nodes={tree}
              slug={document!.slug}
              documentPath={selfPath}
              articleCount={articles.length}
              activeNumber={activeNumber}
              currentLabel={currentLabel}
              query={rawQuery}
            />
          </aside>

          <!-- ─────────── En-tête : élément de grille à part, pour que le
               sommaire s'intercale entre le titre et le texte en mobile ─────── -->
          <header class="order-1 lg:order-none min-w-0 lg:col-start-2 lg:row-start-1">
              <div class="flex flex-wrap items-center gap-2 mb-3.5">
                <span class="inline-flex items-center px-3 py-1 rounded bg-secondary-tint text-secondary text-xs font-bold tracking-wide uppercase">{typeName}</span>
                {document!.legal_scope && scopeLabel[document!.legal_scope] && (
                  <span class="inline-flex items-center px-3 py-1 rounded bg-surface-container text-on-surface-variant text-xs font-medium">{scopeLabel[document!.legal_scope]}</span>
                )}
                {document!.reference_nor && <span class="text-xs sm:text-sm text-on-surface-muted">Réf. {document!.reference_nor}</span>}
              </div>

              <h1 class="font-serif text-[1.75rem] leading-[1.15] sm:text-4xl md:text-[2.4rem] md:leading-[1.12] font-semibold text-on-surface tracking-tight mb-3 max-w-[24ch]">{document!.titre_officiel}</h1>

              {/* Le H1 reste l'intitulé officiel — c'est lui qui fait foi. L'objet
                  dérivé du corps de l'acte s'affiche EN DESSOUS, nommé comme tel,
                  pour les actes que le JO a publiés en abrégé. */}
              {document!.libelle_descriptif && (
                <p class="text-lg text-on-surface-variant font-serif leading-snug mb-3 max-w-[62ch]">{document!.libelle_descriptif}</p>
              )}

              {/* Une seule ligne de faits : la date ne se dit qu'une fois sur la
                  page. Le chapeau généré la répétait mot pour mot. */}
              <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-sm text-on-surface-variant">
                <span><span class="font-semibold text-on-surface">{articles.length}</span> articles</span>
                {sectionCount > 0 && (
                  <span><span class="font-semibold text-on-surface">{sectionCount}</span> divisions</span>
                )}
                {(publishedDate || signedDate) && (
                  <span>{publishedDate ? `Publié le ${publishedDate}` : `Signé le ${signedDate}`}</span>
                )}
                {document!.institution?.nom && <span>{document!.institution.nom}</span>}
              </div>

              {themes.length > 0 && (
                <div class="flex flex-wrap items-center gap-2 mt-4">
                  <span class="text-sm text-on-surface-variant">Situations&nbsp;:</span>
                  {themes.map((theme) => (
                    <a href={`/situations/${theme.slug}`} class="inline-flex items-center px-2.5 py-1 rounded bg-surface-container text-on-surface-variant text-xs font-medium hover:bg-secondary-tint hover:text-secondary transition-colors">
                      {theme.name}
                    </a>
                  ))}
                </div>
              )}

            <LegalStatusBanner document={document!} class="mt-5" />
          </header>

          <!-- ─────────── Colonne centrale : le texte ─────────── -->
          <div class="order-3 lg:order-none min-w-0 lg:col-start-2 lg:row-start-2">

            {search ? (
              <DocumentSearchResults
                query={rawQuery}
                results={search.items}
                total={search.meta.total}
                slug={document!.slug}
                documentPath={selfPath}
                directArticle={directArticle}
              />
            ) : section && section.articles.length > 0 ? (
              <>
                <SectionReader section={section} slug={document!.slug} pdfUrl={pdfUrl} />

                {section.next && (
                  <nav aria-label="Suite du texte" class="mt-5 flex justify-end print:hidden">
                    <a
                      href={section.next.id ? `${selfPath}#sommaire` : selfPath}
                      class="inline-flex items-center gap-2 text-sm font-semibold text-secondary hover:underline"
                    >
                      Poursuivre dans le sommaire
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    </a>
                  </nav>
                )}
              </>
            ) : articles.length === 0 ? (
              <p class="rounded-lg border border-surface-variant bg-surface-container-lowest p-6 text-on-surface-variant italic">
                Aucun article de ce texte n’est publié à ce jour.{pdfUrl ? ' Le PDF d’origine reste consultable ci-dessous.' : ''}
              </p>
            ) : (
              /* L'API ne sert pas (encore) les divisions : le site et le
                 dashboard se déploient indépendamment. On n'affirme surtout pas
                 que le texte est indisponible — il a des articles publiés — on
                 ouvre simplement la lecture. */
              <div class="rounded-lg border border-surface-variant bg-surface-container-lowest p-6">
                <p class="text-on-surface-variant">
                  Ce texte compte <span class="font-semibold text-on-surface">{articles.length}</span> articles publiés.
                  Ouvrez-les depuis le sommaire, ou commencez la lecture ci-dessous.
                </p>
                <a
                  href={articlePath(document!.slug, articles[0].number)}
                  class="mt-4 inline-flex h-10 items-center rounded bg-primary px-4 text-sm font-semibold text-on-primary transition-colors hover:bg-primary-container"
                >
                  Commencer la lecture — {articleLeafLabel(articles[0].number)}
                </a>
              </div>
            )}

            {isUnclassifiedType(document!.type_code) && (
              <p class="mt-4 text-sm text-on-surface-variant border-l-2 border-secondary/50 pl-4">
                Document non classé&nbsp;: le découpage en articles peut être incomplet.{' '}
                {pdfUrl && <a href="#pdf-original" class="text-secondary font-semibold hover:underline">Consultez le PDF original</a>}{pdfUrl ? ' pour le texte intégral.' : ''}
              </p>
            )}

            <ReportIssue documentId={document!.id} returnTo={selfPath} status={reportStatus} />

            <!-- PDF original : replié par défaut, sous le texte. -->
            {pdfUrl && (
              <details id="pdf-original" class="group mt-8 rounded-lg border border-surface-variant bg-surface-container-lowest overflow-hidden scroll-mt-24 print:hidden">
                <summary class="flex items-center gap-3 h-14 px-4 sm:px-5 cursor-pointer list-none select-none hover:bg-surface-container-low transition-colors">
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded bg-secondary-tint text-secondary shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v5h5"></path></svg>
                  </span>
                  <span class="flex flex-col flex-1">
                    <span class="font-semibold text-on-surface">Voir le PDF original</span>
                    <span class="text-sm text-on-surface-variant">Le document source, tel que publié.</span>
                  </span>
                  <svg class="text-on-surface-variant transition-transform group-open:rotate-180 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                </summary>
                <div class="border-t border-surface-variant">
                  <!-- Desktop : intégration directe (chargée seulement à l'ouverture) -->
                  <iframe
                    src={pdfUrl}
                    title={`PDF original — ${intituleUneLigne}`}
                    loading="lazy"
                    class="hidden lg:block w-full h-[80vh] bg-surface-container-low"
                  ></iframe>
                  <!-- Mobile : ouverture native (rendu PDF embarqué peu fiable sur mobile) -->
                  <div class="lg:hidden flex flex-col gap-3 p-5">
                    <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class={btnPrimary}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                      Ouvrir le PDF dans un nouvel onglet
                    </a>
                    {pdfDownloadUrl && (
                      <a href={pdfDownloadUrl} class={btnGhost}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10l5 5 5-5"></path><path d="M12 15V3"></path></svg>
                        Télécharger le PDF
                      </a>
                    )}
                  </div>
                </div>
              </details>
            )}

            <!-- Pour aller plus loin : SOUS le texte. Aucun appel à l'action ne
                 s'interpose entre une personne et le texte qu'elle est venue lire
                 (charte, loi 2). -->
            <section aria-label="Pour aller plus loin" class="mt-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-lg border border-surface-variant bg-surface-container-low p-5 sm:p-6 print:hidden">
              <div>
                <h2 class="text-base font-bold text-on-surface mb-1">Pour aller plus loin</h2>
                <p class="text-sm text-on-surface-variant">Comprenez ce texte en français clair, ou suivez la démarche correspondante pas à pas.</p>
              </div>
              <a href="/guides" class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline whitespace-nowrap">
                Guides et démarches
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </section>
          </div>

          <!-- ─────────── Rail droit : outils + provenance ─────────── -->
          <aside class="order-4 lg:order-none flex flex-col gap-4 sm:flex-row sm:gap-4 xl:flex-col lg:col-start-2 lg:row-start-3 xl:col-start-3 xl:row-start-1 xl:row-span-3 xl:self-start xl:sticky xl:top-24 print:hidden">
            <div class="flex-1 min-w-0">
              <DocumentTools reference={reference} url={selfUrl} title={intituleUneLigne} pdfUrl={pdfUrl} pdfDownloadUrl={pdfDownloadUrl} />
            </div>
            <div class="flex-1 min-w-0">
              <LegalDocumentEvidence document={document!} pdfUrl={pdfUrl} />
            </div>
          </aside>

        </div>
      </div>
    )}
  </main>
  <Footer />
  {!notFound && <OpenInAppBanner path={selfPath} label={intituleUneLigne} />}
</Layout>
