---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DocumentTree from '../../../components/DocumentTree.astro';
import ShareActions from '../../../components/ShareActions.astro';
import OpenInAppBanner from '../../../components/OpenInAppBanner.astro';
import LegalDocumentEvidence from '../../../components/LegalDocumentEvidence.astro';
import { fetchPublicDocument, buildTree, countStructureDivisions, documentPath, pdfProxyUrl } from '../../../lib/api';
import { documentLineLabel } from '../../../lib/sanitize';
import { documentChapeauSubject, documentTypeLabel, formatFrenchDate, isUnclassifiedType, legalStatusPresentation } from '../../../lib/legalMetadata';

const { doc } = Astro.params;
const payload = doc ? await fetchPublicDocument(doc) : null;
const notFound = !payload;

if (notFound) {
  Astro.response.status = 404;
}

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const document = payload?.document;
const articles = payload?.articles ?? [];
const tree = buildTree(payload?.structure);
const sectionCount = countStructureDivisions(tree);
const hasPdf = Boolean(payload?.has_pdf);
const pdfUrl = document && hasPdf ? pdfProxyUrl(document.id) : null;
const pdfDownloadUrl = document && hasPdf ? pdfProxyUrl(document.id, { download: true }) : null;

const typeName = documentTypeLabel(document);

/**
 * Intitulé sur une ligne, pour tout ce qui ne dispose pas de deux lignes : la
 * balise `<title>`, la méta-description, le fil d'Ariane, le partage. Sur un
 * acte en abrégé, `titre_officiel` seul ne dit que « Décret n° 2025-240 du
 * 20 juin 2025. » — illisible pour un lecteur comme pour un moteur. Le H1 de
 * la page, lui, garde l'intitulé officiel SEUL : c'est lui qui fait foi.
 */
const intituleUneLigne = documentLineLabel(document?.titre_officiel, document?.libelle_descriptif);

const selfPath = document ? documentPath(document.slug) : '';
const selfUrl = selfPath ? new URL(selfPath, siteOrigin).href : '';

const scopeLabel: Record<string, string> = {
  national: 'National',
  ohada: 'OHADA',
  communautaire: 'Communautaire',
};

// Chapeau éditorial : phrase NEUTRE construite uniquement à partir des
// métadonnées disponibles (type, date, statut) — aucune phrase juridique
// inventée. On décrit ce que Mibeko sait du texte, pas ce qu'il dit.
const signedDate = formatFrenchDate(document?.date_signature);
const publishedDate = formatFrenchDate(document?.date_publication);
const chapeauParts: string[] = [];
if (document) {
  chapeauParts.push(documentChapeauSubject(document));
  if (document.institution?.nom) chapeauParts.push(`émane de ${document.institution.nom}`);
  if (publishedDate) chapeauParts.push(`a été publié le ${publishedDate}`);
  else if (signedDate) chapeauParts.push(`a été signé le ${signedDate}`);
}
// Le sujet du chapeau porte le premier segment ; les compléments qui suivent
// sont séparés par des virgules. Sans ce cas particulier, un texte sans
// institution donnait « Ce journal officiel, a été signé le … » — une virgule
// qui sépare le sujet de son verbe.
const chapeau =
  chapeauParts.length > 2
    ? `${chapeauParts[0]} ${chapeauParts.slice(1).join(', ')}.`
    : chapeauParts.length === 2
      ? `${chapeauParts[0]} ${chapeauParts[1]}.`
      : '';

const status = legalStatusPresentation(document);
const themes = document?.themes ?? [];

const legislationLd = document
  ? {
      '@context': 'https://schema.org',
      '@type': 'Legislation',
      name: document.titre_officiel,
      legislationType: typeName,
      legislationJurisdiction: { '@type': 'AdministrativeArea', name: 'République du Congo' },
      inLanguage: 'fr',
      url: selfUrl,
      ...(document.reference_nor ? { legislationIdentifier: document.reference_nor } : {}),
      ...(document.date_publication ? { datePublished: document.date_publication } : {}),
    }
  : null;

const breadcrumbLd = document
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', siteOrigin).href },
        { '@type': 'ListItem', position: 2, name: 'Textes officiels', item: new URL('/textes', siteOrigin).href },
        { '@type': 'ListItem', position: 3, name: document.titre_officiel, item: selfUrl },
      ],
    }
  : null;

const jsonLd = [legislationLd, breadcrumbLd].filter(Boolean) as Record<string, unknown>[];

const btnPrimary = 'inline-flex items-center justify-center gap-2 h-11 px-5 rounded-lg bg-primary text-on-primary font-semibold text-sm hover:bg-primary-container transition-colors';
const btnGhost = 'inline-flex items-center justify-center gap-2 h-11 px-5 rounded-lg border border-surface-variant bg-surface-container-lowest text-on-surface font-semibold text-sm hover:border-primary/40 transition-colors';
---

<Layout
  title={notFound ? 'Texte introuvable — Mibeko' : `${intituleUneLigne} — Mibeko`}
  description={notFound
    ? "Ce texte n'est pas disponible dans le fonds Mibeko."
    : `${intituleUneLigne} — ${typeName} de la République du Congo. ${articles.length} articles, consultables librement sur Mibeko.`}
  ogType="article"
  canonical={selfUrl || undefined}
  jsonLd={jsonLd}
  appArgument={selfUrl || undefined}
>
  <Header />
  <main id="main" class="flex-grow bg-background">
    {notFound ? (
      <section class="max-w-[700px] mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-secondary mb-4">Erreur 404</p>
        <h1 class="text-3xl md:text-4xl font-bold text-on-surface mb-6">Ce texte est introuvable</h1>
        <a href="/textes" class="inline-flex items-center h-11 px-6 bg-primary text-on-primary font-semibold rounded hover:bg-primary-container transition-colors">
          Parcourir le fonds juridique
        </a>
      </section>
    ) : (
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-10">

        <nav aria-label="Fil d'Ariane" class="text-sm text-on-surface-variant mb-5 flex flex-wrap items-center gap-1.5">
          <a href="/" class="hover:text-primary transition-colors">Accueil</a>
          <span class="text-on-surface-muted">/</span>
          <a href="/textes" class="hover:text-primary transition-colors">Textes officiels</a>
          <span class="text-on-surface-muted">/</span>
          <span class="text-on-surface font-medium line-clamp-1">{intituleUneLigne}</span>
        </nav>

        <!-- Bandeau-titre (masthead) + chapeau éditorial -->
        <header class="relative overflow-hidden rounded-lg border border-surface-variant bg-surface-container-lowest p-6 sm:p-8 md:p-10 mb-6">
          <svg aria-hidden="true" class="hidden sm:block absolute -right-8 -top-10 text-primary/[0.04] pointer-events-none" width="280" height="280" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="m5 21 1-9 6-4 6 4 1 9"></path><path d="M12 8V3"></path><path d="M9 3h6"></path><path d="M8 12h8"></path><path d="M8 16h8"></path></svg>
          <div class="relative max-w-[44rem]">
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-lg bg-secondary/10 text-secondary text-xs font-bold tracking-wide uppercase">{typeName}</span>
              {document!.legal_scope && scopeLabel[document!.legal_scope] && (
                <span class="inline-flex items-center px-3 py-1 rounded-lg bg-surface-container text-on-surface-variant text-xs font-medium">{scopeLabel[document!.legal_scope]}</span>
              )}
              <span class:list={[
                'inline-flex items-center px-3 py-1 rounded-lg text-xs font-semibold',
                status.verified ? 'bg-primary/10 text-primary' : 'bg-surface-container text-on-surface-variant',
              ]}>{status.label}</span>
              {document!.reference_nor && <span class="text-xs sm:text-sm text-on-surface-muted">Réf. {document!.reference_nor}</span>}
            </div>

            <h1 class="font-serif text-[1.75rem] leading-[1.15] sm:text-4xl md:text-[2.6rem] md:leading-[1.1] font-semibold text-on-surface tracking-tight mb-4">{document!.titre_officiel}</h1>

            {/* Le H1 reste l'intitulé officiel — c'est lui qui fait foi. L'objet
                dérivé du corps de l'acte s'affiche EN DESSOUS, nommé comme tel,
                pour les actes que le JO a publiés en abrégé. */}
            {document!.libelle_descriptif && (
              <p class="text-lg sm:text-xl text-on-surface-variant font-serif leading-snug -mt-2 mb-4">{document!.libelle_descriptif}</p>
            )}

            {chapeau && (
              <p class="text-base sm:text-lg text-on-surface-variant font-serif leading-relaxed mb-5">{chapeau}</p>
            )}

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-on-surface-variant mb-6">
              <span class="inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-muted"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg>
                <span><span class="font-semibold text-on-surface">{articles.length}</span> articles</span>
              </span>
              {sectionCount > 0 && (
                <span class="inline-flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-muted"><line x1="8" x2="21" y1="6" y2="6"></line><line x1="8" x2="21" y1="12" y2="12"></line><line x1="8" x2="21" y1="18" y2="18"></line><line x1="3" x2="3.01" y1="6" y2="6"></line><line x1="3" x2="3.01" y1="12" y2="12"></line><line x1="3" x2="3.01" y1="18" y2="18"></line></svg>
                  <span><span class="font-semibold text-on-surface">{sectionCount}</span> divisions</span>
                </span>
              )}
              {(publishedDate || signedDate) && (
                <span class="inline-flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-muted"><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg>
                  {publishedDate ? `Publié le ${publishedDate}` : `Signé le ${signedDate}`}
                </span>
              )}
            </div>

            {themes.length > 0 && (
              <div class="flex flex-wrap items-center gap-2 mb-6">
                <span class="text-sm text-on-surface-variant">Situations :</span>
                {themes.map((theme) => (
                  <a href={`/situations/${theme.slug}`} class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-container text-on-surface-variant text-xs font-medium hover:bg-secondary/10 hover:text-secondary transition-colors">
                    {theme.name}
                  </a>
                ))}
              </div>
            )}

          </div>
        </header>

        <LegalDocumentEvidence document={document!} pdfUrl={pdfUrl} />

        <!-- Pour aller plus loin : orientation citoyenne (guides + démarches fusionnés) -->
        <section aria-label="Pour aller plus loin" class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-lg border border-surface-variant bg-surface-container-low p-5 sm:p-6">
          <div>
            <h2 class="text-base font-bold text-on-surface mb-1">Pour aller plus loin</h2>
            <p class="text-sm text-on-surface-variant">Comprenez ce texte en français clair, ou suivez la démarche correspondante pas à pas.</p>
          </div>
          <a href="/guides" class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline whitespace-nowrap">
            Guides et démarches
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </section>

        <!-- Sommaire (navigable) -->
        <section aria-label="Sommaire" class="rounded-lg border border-surface-variant bg-surface-container-lowest overflow-hidden mb-6">
          <div class="flex items-center gap-2 h-12 px-4 border-b border-surface-variant bg-surface-container-low">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><line x1="8" x2="21" y1="6" y2="6"></line><line x1="8" x2="21" y1="12" y2="12"></line><line x1="8" x2="21" y1="18" y2="18"></line><line x1="3" x2="3.01" y1="6" y2="6"></line><line x1="3" x2="3.01" y1="12" y2="12"></line><line x1="3" x2="3.01" y1="18" y2="18"></line></svg>
            <span class="text-xs font-bold uppercase tracking-[0.08em] text-on-surface-variant">Sommaire</span>
          </div>
          {tree.length > 0 ? (
            <div class="p-2 sm:p-3">
              <DocumentTree nodes={tree} slug={document!.slug} />
            </div>
          ) : (
            <p class="p-6 text-on-surface-variant italic">Aucun article publié pour ce texte.</p>
          )}
          {isUnclassifiedType(document!.type_code) && (
            <p class="px-4 py-3 sm:px-5 text-sm text-on-surface-variant border-t border-surface-variant bg-surface-container-low">
              Document non classé : le découpage en articles peut être incomplet.{' '}
              {pdfUrl && <a href="#pdf-original" class="text-secondary font-semibold hover:underline">Consultez le PDF original</a>}{pdfUrl ? ' pour le texte intégral.' : ''}
            </p>
          )}
        </section>

        <!-- PDF original : replié par défaut (plus d'iframe sticky d'entrée) -->
        {pdfUrl && (
          <details id="pdf-original" class="group rounded-lg border border-surface-variant bg-surface-container-lowest overflow-hidden scroll-mt-24">
            <summary class="flex items-center gap-3 h-14 px-4 sm:px-5 cursor-pointer list-none select-none hover:bg-surface-container-low transition-colors">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-secondary/10 text-secondary shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v5h5"></path></svg>
              </span>
              <span class="flex flex-col flex-1">
                <span class="font-semibold text-on-surface">Voir le PDF original</span>
                <span class="text-sm text-on-surface-variant">Le document source, tel que publié.</span>
              </span>
              <svg class="text-on-surface-variant transition-colors group-open:rotate-180 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <div class="border-t border-surface-variant">
              <!-- Desktop : intégration directe (chargée seulement à l'ouverture) -->
              <iframe
                src={pdfUrl}
                title={`PDF original — ${intituleUneLigne}`}
                loading="lazy"
                class="hidden lg:block w-full h-[80vh] bg-surface-container-low"
              ></iframe>
              <!-- Mobile : ouverture native (rendu PDF embarqué peu fiable sur mobile) -->
              <div class="lg:hidden flex flex-col gap-3 p-5">
                <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class={btnPrimary}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                  Ouvrir le PDF dans un nouvel onglet
                </a>
                {pdfDownloadUrl && (
                  <a href={pdfDownloadUrl} class={btnGhost}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10l5 5 5-5"></path><path d="M12 15V3"></path></svg>
                    Télécharger le PDF
                  </a>
                )}
              </div>
            </div>
          </details>
        )}

        {pdfDownloadUrl && (
          <div class="hidden lg:flex mt-4 flex-wrap gap-2.5">
            <a href={pdfDownloadUrl} class={btnGhost}>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10l5 5 5-5"></path><path d="M12 15V3"></path></svg>
              Télécharger le PDF
            </a>
          </div>
        )}

        <ShareActions url={selfUrl} title={intituleUneLigne} heading="Partager ce texte" />

      </div>
    )}
  </main>
  <Footer />
  {!notFound && <OpenInAppBanner path={selfPath} label={intituleUneLigne} />}
</Layout>
