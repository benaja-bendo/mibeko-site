---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DocumentOutline from '../../../components/DocumentOutline.astro';
import DocumentTools from '../../../components/DocumentTools.astro';
import LegalStatusBanner from '../../../components/LegalStatusBanner.astro';
import ArticleVersionBanner from '../../../components/ArticleVersionBanner.astro';
import ArticleVersionSelector from '../../../components/ArticleVersionSelector.astro';
import SectionReader from '../../../components/SectionReader.astro';
import ReportIssue from '../../../components/ReportIssue.astro';
import OpenInAppBanner from '../../../components/OpenInAppBanner.astro';
import LegalArticleBody from '../../../components/LegalArticleBody.astro';
import LegalDocumentEvidence from '../../../components/LegalDocumentEvidence.astro';
import {
  fetchPublicDocument,
  buildTree,
  canonicalSlug,
  documentPath,
  articlePath,
  pdfProxyUrl,
  ApiUnavailableError,
  type ArticleVersionRef,
} from '../../../lib/api';
import { findVersionAt, isValidDateParam } from '../../../lib/articleVersions';
import { articleLeafLabel, documentLineLabel } from '../../../lib/sanitize';
import { articlePlainText } from '../../../lib/tables';
import { documentTypeLabel, formatFrenchDate, formatSectionPath, isUnclassifiedType } from '../../../lib/legalMetadata';
import { UMAMI_EVENTS } from '../../../lib/analytics';

const ARTICLE_PREFIX = 'article-';
const { doc, article: articleParam } = Astro.params;

// `?au=YYYY-MM-DD` (mibeko-dashboard#157/#167) : version de l'article à une
// date donnée. Validé ici, jamais transmis à l'API sous une forme douteuse —
// un format libre y renverrait 422 ; on préfère alors ignorer silencieusement
// le paramètre et servir la version en vigueur plutôt qu'une page d'erreur
// pour un lecteur qui a mal tapé une date. `auRequested` (brut, non validé)
// pilote uniquement le `noindex` : une URL qui PORTE `au=`, valide ou non,
// n'est jamais celle qu'on veut voir indexée.
const auRequested = Astro.url.searchParams.get('au');
const au = isValidDateParam(auRequested) ? auRequested : undefined;

let payload = null;
let invalid = !doc || !articleParam || !articleParam.startsWith(ARTICLE_PREFIX);
let numero = '';
let unavailable = false;

if (!invalid) {
  numero = decodeURIComponent(articleParam!.slice(ARTICLE_PREFIX.length));
  // `section=auto` : la division qui CONTIENT cet article, pour la lecture
  // continue. Un seul aller-retour, et l'URL de l'article ne bouge pas — elle
  // reste canonique, déclarée en App Link et présente au sitemap.
  // Désactivée quand une date est demandée : la section entière refléterait
  // la version EN VIGUEUR des articles voisins, incohérent avec un seul
  // article épinglé à une date passée.
  try {
    payload = await fetchPublicDocument(doc!, numero, au ? undefined : 'auto', au);
  } catch (error) {
    // API injoignable (mibeko-site#48) : 503 + Retry-After, jamais un 404 —
    // Google réessaie au lieu de désindexer l'article.
    if (!(error instanceof ApiUnavailableError)) throw error;
    unavailable = true;
  }
}

const notFound = !unavailable && (invalid || !payload || !payload.current_article);
const empty = notFound || unavailable;

if (notFound) {
  Astro.response.status = 404;
}
if (unavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '120');
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Ancien slug du document (filet d'alias, mibeko-dashboard#155) : 301 vers
// l'article sous le slug canonique, avant tout rendu, requête conservée. Seulement
// quand la page aurait rendu — un article inconnu reste un 404, même sous un
// ancien slug : rediriger vers une adresse qui répondra 404 n'aiderait personne.
// Ni quand l'API est injoignable (`payload` nul) : c'est la page 503.
if (!empty && canonicalSlug(payload!) !== doc) {
  return Astro.redirect(`${articlePath(canonicalSlug(payload!), numero)}${Astro.url.search}`, 301);
}

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const reportStatus = Astro.url.searchParams.get('signalement');

const document = payload?.document;
const current = payload?.current_article;
const articles = payload?.articles ?? [];
const tree = buildTree(payload?.structure);
const section = payload?.section ?? null;

// Repli : tant que l'API n'expose pas `section` (déploiements indépendants du
// site et du dashboard), la page rend l'article seul, comme avant. Jamais en
// lecture par date (§ ci-dessus).
const hasSection = !au && Boolean(section && section.articles.some((a) => a.number === current?.number));
const currentLabel = hasSection ? formatSectionPath(section!.path) || undefined : undefined;

// Historique des versions (mibeko-dashboard#167) : un seul élément tant
// qu'aucun amendement légal réel n'a été enregistré — le sélecteur (rendu
// seulement si > 1) et le bandeau de contexte s'appuient dessus.
const versions: ArticleVersionRef[] = current?.versions ?? [];
const versionFound = current?.version_found ?? true;
const selectedVersion = au ? findVersionAt(versions, au) : null;

const idx = current ? articles.findIndex((a) => a.number === current.number) : -1;
const previous = idx > 0 ? articles[idx - 1] : null;
const next = idx >= 0 && idx < articles.length - 1 ? articles[idx + 1] : null;

// Intitulé du document parent sur une ligne : sur un acte en abrégé,
// `titre_officiel` seul ne dit que « Décret n° … du … », ce qui rend le
// titre de page, le partage et le fil d'Ariane muets.
const intituleParent = documentLineLabel(document?.titre_officiel, document?.libelle_descriptif);

// Texte SEO : un tableau y entre linéarisé (« A | B | C »), jamais en balises —
// la description et le JSON-LD en dérivent tous les deux.
const plain = articlePlainText(current?.content, current?.tables).replace(/\s+/g, ' ').trim();
const description = plain
  ? plain.length > 160
    ? `${plain.slice(0, 157)}…`
    : plain
  : `Article ${numero} du ${intituleParent} — République du Congo.`;

// Libellé de la feuille : « Article 5 », mais « Tableau 1 » ou « Préambule »
// pour les feuilles techniques du pipeline.
const articleLabel = current ? articleLeafLabel(current.number) : '';

const pageTitle = document && current
  ? `${articleLabel} — ${intituleParent}`
  : 'Texte introuvable';

const typeName = documentTypeLabel(document);
const hasPdf = Boolean(payload?.has_pdf);
const pdfUrl = document && hasPdf ? pdfProxyUrl(document.id) : null;
const pdfDownloadUrl = document && hasPdf ? pdfProxyUrl(document.id, { download: true }) : null;
const selfPath = document && current ? articlePath(document.slug, current.number) : '';
const selfUrl = selfPath ? new URL(selfPath, siteOrigin).href : '';
const docPath = document ? documentPath(document.slug) : '';
const docUrl = docPath ? new URL(docPath, siteOrigin).href : '';

// Libellé de partage : ce qu'un destinataire doit lire pour situer le texte
// sans avoir à ouvrir le lien.
const shareTitle = document && current
  ? `${articleLabel} — ${intituleParent}`
  : '';

// Référence collable : l'intitulé officiel, l'article, l'URL publique.
const reference = document && current
  ? `${document.titre_officiel}, ${articleLabel.toLocaleLowerCase('fr')} — ${selfUrl}`
  : '';

const legislationLd = document && current
  ? {
      '@context': 'https://schema.org',
      '@type': 'Legislation',
      name: pageTitle,
      legislationType: typeName,
      legislationJurisdiction: { '@type': 'AdministrativeArea', name: 'République du Congo' },
      inLanguage: 'fr',
      url: selfUrl,
      isPartOf: { '@type': 'Legislation', name: document.titre_officiel, url: docUrl },
      ...(document.reference_nor ? { legislationIdentifier: document.reference_nor } : {}),
      ...(document.date_publication ? { datePublished: document.date_publication } : {}),
      ...(plain ? { text: plain } : {}),
    }
  : null;

const breadcrumbLd = document && current
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', siteOrigin).href },
        { '@type': 'ListItem', position: 2, name: 'Textes officiels', item: new URL('/textes', siteOrigin).href },
        { '@type': 'ListItem', position: 3, name: document.titre_officiel, item: docUrl },
        { '@type': 'ListItem', position: 4, name: articleLabel, item: selfUrl },
      ],
    }
  : null;

const jsonLd = [legislationLd, breadcrumbLd].filter(Boolean) as Record<string, unknown>[];

const RELATION_LABELS: Record<string, string> = {
  CITE: 'Référence',
  MODIFIE: 'Modification',
  ABROGE: 'Abrogation',
  COMPLETE: 'Complément',
  RENUMEROTE: 'Renumérotation',
  CREE: 'Création',
};
const related = current?.related ?? [];

// « Loi X, article 5 » / « Loi X, tableau 1 » : le libellé se fond dans la phrase.
const lowerFirst = (label: string) => label.charAt(0).toLowerCase() + label.slice(1);
---

<Layout
  title={unavailable ? 'Texte momentanément indisponible — Mibeko' : notFound ? 'Texte introuvable — Mibeko' : `${pageTitle} — Mibeko`}
  description={description}
  image={document ? `/og/${document.slug}/${articleParam}.png` : undefined}
  ogType="article"
  canonical={selfUrl || undefined}
  noindex={Boolean(auRequested)}
  jsonLd={jsonLd}
  appArgument={selfUrl || undefined}
>
  <Header />
  <main id="main" class="flex-grow bg-background">
    {empty ? (
      <section class="max-w-[700px] mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-secondary mb-4">{unavailable ? 'Erreur 503' : 'Erreur 404'}</p>
        <h1 class="text-3xl md:text-4xl font-bold text-on-surface mb-6">
          {unavailable ? 'Ce texte est momentanément indisponible' : 'Ce texte est introuvable'}
        </h1>
        <p class="text-on-surface-variant font-serif mb-8">
          {unavailable
            ? "Le fonds juridique ne répond pas pour l'instant. Le texte existe toujours : réessayez dans quelques minutes."
            : "L'article ou le texte que vous cherchez n'existe pas, ou n'est pas encore publié dans le fonds Mibeko."}
        </p>
        <a href={unavailable ? Astro.url.pathname : '/textes'} class="inline-flex items-center h-11 px-6 bg-primary text-on-primary font-semibold rounded hover:bg-primary-container transition-colors">
          {unavailable ? 'Réessayer' : 'Parcourir le fonds juridique'}
        </a>
      </section>
    ) : (
      <div class="mx-auto max-w-[1120px] xl:max-w-[1400px] px-4 sm:px-6 lg:px-8 xl:px-10 py-6 md:py-10">

        <nav aria-label="Fil d'Ariane" class="text-sm text-on-surface-variant mb-5 flex flex-wrap items-center gap-1.5 print:hidden">
          <a href="/" class="hover:text-primary transition-colors">Accueil</a>
          <span class="text-on-surface-muted">/</span>
          <a href="/textes" class="hover:text-primary transition-colors">Textes officiels</a>
          <span class="text-on-surface-muted">/</span>
          <a href={docPath} class="hover:text-primary transition-colors line-clamp-1">{intituleParent}</a>
          <span class="text-on-surface-muted">/</span>
          <span class="text-on-surface font-medium">{articleLabel}</span>
        </nav>

        <!-- Même grille que la page document : le rail droit passe sous la
             colonne de texte en dessous de 1280 px, la mesure ne rétrécit pas. -->
        <div class="grid gap-6 lg:gap-8 lg:grid-cols-[280px_minmax(0,1fr)] xl:grid-cols-[280px_minmax(0,1fr)_272px]">

          <!-- Sommaire : rail sticky (desktop) + accordéon (mobile). Rendu UNE
               seule fois (l'arbre peut être volumineux) ; bascule CSS pure. -->
          <!-- Rail gauche : le sommaire -->
          <aside class="order-2 lg:order-none min-w-0 lg:col-start-1 lg:row-start-1 lg:row-span-3 lg:self-start lg:sticky lg:top-24 print:hidden">
            <DocumentOutline
              nodes={tree}
              slug={document!.slug}
              documentPath={docPath}
              articleCount={articles.length}
              activeNumber={current!.number}
              currentLabel={currentLabel}
            />
          </aside>

          <!-- En-tête : élément de grille à part, pour que le sommaire
               s'intercale entre le titre et le texte en mobile -->
          <header class="order-1 lg:order-none min-w-0 lg:col-start-2 lg:row-start-1">
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <span class="inline-flex items-center px-3 py-1 rounded bg-secondary-tint text-secondary text-xs font-bold tracking-wide uppercase">
                  {typeName}
                </span>
                {document!.date_publication && (
                  <span class="text-xs sm:text-sm text-on-surface-variant">Publié le {formatFrenchDate(document!.date_publication)}</span>
                )}
                {document!.reference_nor && (
                  <span class="text-xs sm:text-sm text-on-surface-muted">Réf. {document!.reference_nor}</span>
                )}
              </div>
              <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-on-surface tracking-tight leading-tight mb-3">
                {articleLabel}
              </h1>
              <a href={docPath} class="text-base sm:text-lg text-on-surface-variant font-serif hover:text-primary transition-colors">
                {document!.titre_officiel}
              </a>
              {/* Objet dérivé du corps de l'acte, sous l'intitulé officiel du
                  texte parent — jamais à sa place. */}
              {document!.libelle_descriptif && (
                <p class="mt-1 text-sm sm:text-base text-on-surface-muted font-serif leading-snug">{document!.libelle_descriptif}</p>
              )}

            {/* Charte § 4, règle 1 : le statut s'affiche sur TOUTE page qui montre
                du texte de loi. Une personne arrivée par Google sur un article
                isolé doit savoir, sans remonter d'un niveau, s'il s'applique. */}
            <LegalStatusBanner document={document!} class="mt-5" />

            <ArticleVersionSelector versions={versions} basePath={selfPath} selectedStart={au ?? versions.find((v) => v.is_current)?.start ?? ''} />
          </header>

          <!-- Colonne article -->
          <div class="order-3 lg:order-none min-w-0 lg:col-start-2 lg:row-start-2">

            {au && !versionFound && (
              <ArticleVersionBanner
                state="unknown"
                earliestKnownDate={current!.earliest_known_date}
                currentVersionPath={selfPath}
              />
            )}
            {/* Rien à signaler si `au` tombe dans la période encore en vigueur —
                la page affiche alors exactement ce qu'elle aurait affiché sans
                `?au=`, il n'y a pas de « version antérieure » à distinguer. */}
            {au && versionFound && selectedVersion && !selectedVersion.is_current && (
              <ArticleVersionBanner
                state="found"
                periodStart={selectedVersion.start}
                periodEnd={selectedVersion.end}
                modifiePar={selectedVersion.modifie_par}
                currentVersionPath={selfPath}
              />
            )}

            {hasSection ? (
              <SectionReader section={section!} slug={document!.slug} activeNumber={current!.number} pdfUrl={pdfUrl} />
            ) : versionFound ? (
              <div class="rounded-lg border border-surface-variant bg-surface-container-lowest p-5 sm:p-7 md:p-8">
                <div>
                  <LegalArticleBody content={current!.content} tables={current!.tables} />
                </div>
              </div>
            ) : null}

            {isUnclassifiedType(document!.type_code) && (
              <p class="mt-4 text-sm text-on-surface-variant border-l-2 border-secondary/50 pl-4">
                Document non classé&nbsp;: ce texte peut s'arrêter avant la fin du document source.{' '}
                {pdfUrl && <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="text-secondary font-semibold hover:underline">Consultez le PDF original</a>}{pdfUrl ? ' pour vérifier.' : ''}
              </p>
            )}

            <!-- Navigation entre articles -->
            <nav class="mt-6 pt-5 border-t border-surface-variant flex items-center justify-between gap-4 print:hidden" aria-label="Navigation entre articles">
              {previous ? (
                <a href={articlePath(document!.slug, previous.number)} class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
                  <span class="text-sm font-semibold">{articleLeafLabel(previous.number)}</span>
                </a>
              ) : <span></span>}
              {next ? (
                <a href={articlePath(document!.slug, next.number)} class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors">
                  <span class="text-sm font-semibold">{articleLeafLabel(next.number)}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </a>
              ) : <span></span>}
            </nav>

            {(document!.themes && document!.themes.length > 0) && (
              <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="text-sm text-on-surface-variant">Situations&nbsp;:</span>
                {document!.themes.map((theme) => (
                  <a href={`/situations/${theme.slug}`} class="inline-flex items-center px-2.5 py-1 rounded bg-surface-container text-on-surface-variant text-xs font-medium hover:bg-secondary-tint hover:text-secondary transition-colors">
                    {theme.name}
                  </a>
                ))}
              </div>
            )}

            <ReportIssue articleId={current!.id} documentId={document!.id} returnTo={selfPath} status={reportStatus} />

            <!-- Maillage interne : textes liés (publiés uniquement) -->
            {related.length > 0 && (
              <section class="mt-10">
                <h2 class="text-xl font-bold text-on-surface mb-4">Textes liés</h2>
                <ul class="flex flex-col gap-3">
                  {related.map((rel) => (
                    <li>
                      <a
                        href={rel.article_number ? articlePath(rel.document_slug, rel.article_number) : documentPath(rel.document_slug)}
                        class="flex items-start gap-3 p-4 rounded-lg border border-surface-variant bg-surface-container-lowest hover:border-primary/40 transition-all group"
                      >
                        <span class="inline-flex items-center px-2.5 py-1 rounded bg-secondary-tint text-secondary text-xs font-bold uppercase tracking-wide shrink-0 mt-0.5">
                          {RELATION_LABELS[rel.type] ?? rel.type}
                        </span>
                        <span class="text-on-surface group-hover:text-primary transition-colors font-medium">
                          {rel.document_title}{rel.article_number ? `, ${lowerFirst(articleLeafLabel(rel.article_number))}` : ''}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <!-- Pour aller plus loin : orientation citoyenne (guides / démarches
                 / app), avec une mention pro discrète en pied. Le lecteur d'un
                 article est la personne la plus engagée du site (mibeko-site#24) :
                 la carte Assistant part de ce qu'il vient de lire, pas du produit. -->
            <aside class="mt-12 rounded-lg border border-surface-variant bg-surface-container-low p-6 sm:p-8 print:hidden">
              <h2 class="text-xl font-bold text-on-surface mb-2">Une question sur cet article ?</h2>
              <p class="text-on-surface-variant font-serif mb-8 max-w-xl">
                Ce texte s'applique à des situations concrètes. Comprenez-le en français clair, ou demandez à l'Assistant.
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <a href="/guides" class="flex flex-col gap-2 p-5 rounded-lg border border-surface-variant bg-surface-container-lowest hover:border-primary/40 transition-all group">
                  <span class="text-primary font-bold">Guides et démarches</span>
                  <span class="text-sm text-on-surface-variant">Les grands principes en français simple, et le pas-à-pas pour agir.</span>
                </a>
                <a
                  href="/assistant"
                  data-umami-event={UMAMI_EVENTS.travaillerAssistantTexte}
                  class="flex flex-col gap-2 p-5 rounded-lg border border-surface-variant bg-surface-container-lowest hover:border-primary/40 transition-all group"
                >
                  <span class="text-primary font-bold">Demander à l'Assistant Mibeko</span>
                  <span class="text-sm text-on-surface-variant">Il cherche dans les textes publiés et cite l'article exact. Compte gratuit, sans engagement.</span>
                </a>
              </div>
              <p class="mt-6 text-sm text-on-surface-variant">
                <a href="/application" class="text-secondary font-semibold hover:underline">Emporter le fonds hors connexion</a>{' '}
                avec l'application, ou{' '}
                <a href="/professionnels" class="text-secondary font-semibold hover:underline">découvrir l'espace professionnel</a>.
              </p>
            </aside>
          </div>

          <!-- Rail droit : outils + provenance -->
          <aside class="order-4 lg:order-none flex flex-col gap-4 sm:flex-row sm:gap-4 xl:flex-col lg:col-start-2 lg:row-start-3 xl:col-start-3 xl:row-start-1 xl:row-span-3 xl:self-start xl:sticky xl:top-24 print:hidden">
            <div class="flex-1 min-w-0">
              <DocumentTools reference={reference} url={selfUrl} title={shareTitle} pdfUrl={pdfUrl} pdfDownloadUrl={pdfDownloadUrl} />
            </div>
            <div class="flex-1 min-w-0">
              <LegalDocumentEvidence document={document!} pdfUrl={pdfUrl} />
            </div>
          </aside>

        </div>
      </div>
    )}
  </main>
  <Footer />
  {!empty && (
    <OpenInAppBanner
      path={selfPath}
      label={`${articleLabel} — ${intituleParent}`}
    />
  )}
</Layout>
