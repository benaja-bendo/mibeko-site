---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';

// Un dépôt = une audience. La version pro vit sur /professionnels.
// ID App Store vérifié via https://itunes.apple.com/lookup?bundleId=cg.mibeko.app
const playStoreUrl = 'https://play.google.com/store/apps/details?id=cg.mibeko.app';
const appStoreUrl = 'https://apps.apple.com/app/id6768865781';

const features = [
  {
    title: 'Le fonds juridique, expliqué simplement',
    description: 'Constitution, codes, lois et textes OHADA consultables même hors connexion, avec un accès au document source lorsqu’il est disponible.',
  },
  {
    title: 'L\'Assistant Mibeko répond',
    description: 'Posez vos questions en langage courant. Il répond à partir des textes publiés et cite l\'article exact.',
    href: '/assistant',
    linkLabel: 'Voir trois réponses et leurs sources',
  },
  {
    title: 'Le Journal officiel, suivi',
    description: 'Parcourez les derniers numéros du Journal officiel et les textes qu\'ils publient, depuis votre téléphone.',
  },
  {
    title: 'Vos dossiers, au même endroit',
    description: 'Rassemblez les textes qui vous concernent et retrouvez-les sur tous vos appareils.',
  },
];
---

<Layout
	title="L'application Mibeko — le droit congolais dans votre poche"
	description="L'application mobile Mibeko : le fonds juridique congolais et OHADA, consultable hors connexion, avec l'Assistant Mibeko, qui répond en citant ses sources. Gratuite, sur Android et iPhone."
>
	<Header />
	<main id="main" class="flex-grow bg-background">
		<PageHeader
			eyebrow="L'application"
			title="Le droit congolais dans votre poche"
			subtitle="Conçue pour le grand public : posez vos questions en français courant, explorez le fonds et revenez au document source lorsqu'il est disponible."
		/>

		<section class="py-12 md:py-16">
			<div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex flex-col sm:flex-row gap-3 mb-3">
					<a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2.5 h-12 px-6 bg-primary text-on-primary font-semibold rounded-lg hover:bg-primary-container transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"/></svg>
						Google Play
					</a>
					<a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2.5 h-12 px-6 bg-primary text-on-primary font-semibold rounded-lg hover:bg-primary-container transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.701"/></svg>
						App Store
					</a>
				</div>
				<p class="text-sm text-on-surface-muted mb-12">Gratuite, sans compte requis pour lire. Disponible sur Android et iPhone.</p>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-8">
					{features.map((f) => (
						<div class="pt-4 border-t-2 border-primary/50">
							<h3 class="text-base font-bold text-on-surface mb-1.5">{f.title}</h3>
							<p class="text-sm text-on-surface-variant font-serif leading-relaxed">{f.description}</p>
							{'href' in f && (
								<a href={f.href} class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary hover:underline">{f.linkLabel}</a>
							)}
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="py-12 md:py-16 bg-surface-container-low border-t border-surface-variant/50">
			<div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-xl md:text-2xl font-bold text-on-surface mb-3">Vous cherchez le poste de travail du juriste ?</h2>
				<p class="text-on-surface-variant mb-6">L'espace professionnel réunit recherche avancée, Assistant Mibeko et suivi de dossiers pour les avocats et juristes d'entreprise.</p>
				<a href="/professionnels" class="inline-flex items-center justify-center h-11 px-6 border border-outline-variant/70 text-on-surface font-semibold rounded-lg hover:bg-surface-container transition-colors">
					Découvrir l'espace Pro
				</a>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
