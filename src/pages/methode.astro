---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';

// Page « méthode » (E-E-A-T factuel) : d'où viennent les textes, comment ils
// sont traités. On ne revendique AUCUNE garantie juridique et on ne cite aucun
// juriste nommé (placeholder). Les sources officielles sont celles déjà citées
// dans l'application (conformité Play Store).
const sources = [
  {
    name: 'Secrétariat général du Gouvernement',
    detail: 'Journaux officiels et textes de la République du Congo.',
    url: 'https://www.sgg.cg',
    label: 'sgg.cg',
  },
  {
    name: 'OHADA',
    detail: "Actes uniformes et droit harmonisé de l'espace OHADA.",
    url: 'https://www.ohada.org',
    label: 'ohada.org',
  },
];

const steps = [
  {
    title: 'Collecte des sources officielles',
    description: 'Nous partons des textes publiés par les sources officielles (Journal officiel, sites gouvernementaux et OHADA). Le document source, tel que publié, reste toujours accessible en PDF.',
  },
  {
    title: 'Numérisation et structuration',
    description: 'Les documents sont numérisés puis découpés article par article, en respectant leur arborescence (livres, titres, chapitres, sections). Chaque article devient adressable individuellement.',
  },
  {
    title: 'Contrôles documentés',
    description: 'La numérisation est contrôlée progressivement. Quand une vérification éditoriale ou juridique n’est pas établie, la page le signale au lieu de la supposer.',
  },
  {
    title: 'Métadonnées et statut',
    description: 'Nous affichons les métadonnées disponibles et distinguons le statut déclaré du statut réellement vérifié. Le fonds s’enrichit au fil des documents intégrés.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Notre méthode — Mibeko',
    description: "D'où viennent les textes de Mibeko et comment ils sont traités : sources officielles, numérisation, découpage article par article et état de vérification.",
    inLanguage: 'fr',
  },
];
---

<Layout
  title="Notre méthode — d'où viennent les textes | Mibeko"
  description="Comment Mibeko constitue son fonds juridique : sources officielles, numérisation, découpage article par article et indication de l’état de vérification."
  jsonLd={jsonLd}
>
  <Header />
  <main id="main" class="flex-grow bg-background">
    <PageHeader
      eyebrow="Notre méthode"
      title="D'où viennent les textes"
      subtitle="La confiance passe par la transparence. Voici comment nous constituons et tenons à jour le fonds juridique."
    />

    <!-- Sources officielles -->
    <section class="pb-4 md:pb-8">
      <div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-on-surface mb-2">Des sources officielles</h2>
        <p class="text-on-surface-variant font-serif leading-relaxed mb-6">
          Mibeko ne réécrit pas le droit : il le rend accessible. Nos textes proviennent des publications officielles.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {sources.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="flex flex-col gap-1.5 p-5 rounded-lg border border-surface-variant bg-surface-container-lowest hover:border-primary/40 transition-all group">
              <span class="font-semibold text-on-surface group-hover:text-primary transition-colors">{s.name}</span>
              <span class="text-sm text-on-surface-variant">{s.detail}</span>
              <span class="mt-1 inline-flex items-center gap-1.5 text-sm font-medium text-secondary">
                {s.label}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Pipeline -->
    <section class="py-12 md:py-16">
      <div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-on-surface mb-8">Du document officiel au texte lisible</h2>
        <ol class="flex flex-col gap-5">
          {steps.map((step, i) => (
            <li class="flex gap-4 sm:gap-5">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary text-on-primary font-bold shrink-0">{i + 1}</span>
              <div class="pt-1">
                <h3 class="text-lg font-bold text-on-surface mb-1.5">{step.title}</h3>
                <p class="text-on-surface-variant leading-relaxed">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-surface-container-low border-y border-surface-variant/50">
      <div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-on-surface mb-4">Comment l'Assistant Mibeko utilise ce fonds</h2>
        <p class="text-on-surface-variant leading-relaxed font-serif max-w-[68ch] mb-4">
          L'assistant ne consulte pas une mémoire générale du droit&nbsp;: il cherche dans les textes
          publiés ci-dessus, retient les articles pertinents, et rédige sa réponse à partir d'eux seuls.
          Chaque affirmation renvoie à l'article dont elle provient, et un renvoi qui ne correspond à
          aucun article réellement retrouvé est retiré de la réponse avant affichage.
        </p>
        <p class="text-on-surface-variant leading-relaxed font-serif max-w-[68ch] mb-5">
          Il en découle une limite qu'il faut énoncer&nbsp;: ce que le fonds ne contient pas, l'assistant
          ne peut pas le fonder. Un texte non encore publié ici reste hors de sa portée.
        </p>
        <a href="/assistant" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
          Voir trois réponses et leurs sources
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- Transparence / avertissement -->
    <section class="pb-16 md:pb-24">
      <div class="max-w-[820px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-lg border border-secondary/25 bg-secondary/[0.05] p-6 sm:p-8">
          <h2 class="text-lg font-bold text-on-surface mb-3">Une aide à la compréhension, pas un conseil juridique</h2>
          <p class="text-on-surface-variant leading-relaxed mb-3">
            Mibeko facilite l'accès et la compréhension du droit. Le contenu proposé est fourni à titre d'information et ne remplace pas l'avis d'un professionnel du droit. En cas de doute ou de litige, consultez un avocat ou l'autorité compétente.
          </p>
          <p class="text-on-surface-variant leading-relaxed">
            Lorsqu’un document source est disponible, la page du texte permet de le consulter. La publication au Journal officiel reste la référence qui fait foi.
          </p>
          {/* À COMPLÉTER : gouvernance éditoriale et validation par un juriste
              (nom/qualité) une fois formalisée. Ne pas revendiquer de garantie
              juridique ni citer de juriste nommé tant que ce n'est pas confirmé. */}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
