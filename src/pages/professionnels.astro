---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { UMAMI_EVENTS } from '../lib/analytics';

const features = [
  {
    title: 'Recherche avancée',
    description: 'Recherche hybride (lexicale + sémantique) sur tout le fonds, structurée par l\'arborescence des textes.',
  },
  {
    title: 'Assistant Mibeko',
    description: 'Des réponses avec citations cliquables vers les articles : vous gardez la main sur la source.',
    href: '/assistant',
    linkLabel: 'Voir trois démonstrations',
  },
  {
    title: 'Dossiers & échéances',
    description: 'Inclus dans votre compte gratuit : organisez vos affaires, calculez et suivez vos délais, et recevez des rappels au bon moment.',
  },
  {
    title: 'Export professionnel',
    description: 'Exportez vos textes et dossiers en PDF à l\'identité de votre cabinet.',
  },
];

const faqs = [
  {
    q: 'Combien coûte l\'abonnement Pro ?',
    a: 'Le tarif est confirmé lors de la démonstration, une fois votre pratique et vos besoins connus. Aucun paiement n\'est demandé avant que vous n\'ayez accepté une proposition.',
  },
  {
    q: 'Puis-je essayer avant de m\'engager ?',
    a: 'Oui. Le compte est gratuit et ouvre l\'espace tout de suite ; seul l\'export PDF est réservé à l\'abonnement. Si vous préférez être guidé, demandez une démonstration : elle se fait sur vos propres dossiers.',
  },
];
---

<Layout
	title="Travailler vos dossiers sur Mibeko — avocats et juristes | Mibeko"
	description="Sur ordinateur, Mibeko réunit recherche avancée, Assistant, dossiers et suivi des échéances pour les avocats et les juristes d'entreprise. République du Congo et OHADA."
>
	<Header />
	<main id="main" class="flex-grow bg-background">
		<PageHeader
			eyebrow="Avocats et juristes"
			title="Travaillez vos dossiers sur Mibeko"
			subtitle="Sur ordinateur, pour les avocats et les juristes d'entreprise : rechercher, analyser, organiser ses dossiers et suivre ses délais, au même endroit."
		/>

		<section class="py-12 md:py-16">
			<div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-8">
					{features.map((f) => (
						<div class="pt-4 border-t-2 border-secondary/50">
							<h3 class="text-base font-bold text-on-surface mb-1.5">{f.title}</h3>
							<p class="text-sm text-on-surface-variant font-serif leading-relaxed">{f.description}</p>
							{'href' in f && (
								<a href={f.href} class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary hover:underline">{f.linkLabel}</a>
							)}
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="py-16 md:py-20 bg-surface-container-low border-y border-surface-variant/50">
			<div class="max-w-[680px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-4">Voir Mibeko avec vos propres dossiers</h2>
				{/* Écrit du côté du visiteur : ce qu'il peut faire tout de suite, puis
				    l'aide qu'on lui offre. Les deux versions précédentes parlaient
				    notre langue interne (« tant que ce cadre n'est pas confirmé »,
				    « avant toute proposition commerciale ») : mibeko-site#34, #74. */}
				<p class="text-on-surface-variant font-serif leading-relaxed mb-8">
					Créez un compte gratuit&nbsp;: la bibliothèque, les dossiers, le Journal officiel et l'Assistant s'ouvrent tout de suite, sans moyen de paiement. Si vous préférez être guidé, nous vous montrons Mibeko sur vos propres dossiers.
				</p>
				{/* L'essai libre passe en premier (mibeko-site#34) : un cabinet peut
				    voir l'outil lui-même, en une minute, avant de parler à qui que ce
				    soit. La démonstration accompagnée reste offerte en second, pour
				    qui préfère être guidé. */}
				<div class="flex flex-col sm:flex-row gap-3 justify-center">
					<a
						href="https://app.mibeko.fr/auth/register"
						target="_blank"
						rel="noopener noreferrer"
						data-umami-event={UMAMI_EVENTS.compteCreer}
						class="inline-flex items-center justify-center h-12 px-8 bg-primary text-on-primary font-semibold rounded-lg hover:bg-primary-container transition-colors"
					>
						Créer un compte gratuit
					</a>
					<a href="/contact" data-umami-event={UMAMI_EVENTS.travaillerDemo} class="inline-flex items-center justify-center h-12 px-8 border border-outline-variant/70 text-on-surface font-semibold rounded-lg hover:bg-surface-container transition-colors">
						Demander une démonstration accompagnée
					</a>
				</div>
				<p class="mt-6 text-sm text-on-surface-variant">
					Déjà client ?{' '}
					<a
						href="https://app.mibeko.fr/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-secondary font-semibold hover:underline"
					>Se connecter à Mibeko</a>{' '}
					— la lecture des textes reste libre et sans compte, pour tous.
				</p>
			</div>
		</section>

		<section class="py-16 md:py-20">
			<div class="max-w-[760px] mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-xl font-bold text-on-surface mb-6">Questions fréquentes</h2>
				<div class="flex flex-col gap-4">
					{faqs.map((item) => (
						<details class="group rounded-lg border border-surface-variant bg-surface-container-lowest p-5">
							<summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-on-surface gap-3">
								{item.q}
								<svg class="text-on-surface-variant transition-colors group-open:rotate-180 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
							</summary>
							<p class="mt-3 text-sm text-on-surface-variant leading-relaxed">{item.a}</p>
						</details>
					))}
				</div>
				<p class="mt-8 text-sm text-on-surface-variant">
					Vous cherchez à lire le droit, pas à l'organiser ?{' '}
					<a href="/textes" class="text-primary font-semibold hover:underline">Le fonds reste consultable librement</a>, sans compte.
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
