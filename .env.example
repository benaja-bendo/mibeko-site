# --- Configuration du site vitrine Mibeko ---
# Copiez ce fichier en `.env` pour le développement local : `cp .env.example .env`
# (`.env` et `.env.production` sont git-ignorés.)

# Base de l'API Laravel consommée par le site (SSR + relais /api/contact).
# Priorité : process.env (runtime, prod) > import.meta.env (build/dev) > défaut prod.
#
#   Local   → l'API Laravel tourne sur http://localhost:8000 (php artisan serve)
#   Prod    → https://api.mibeko.fr/api/v1 (injecté au runtime du conteneur)
#
# Laisser vide reviendrait à taper la PROD même en local : à éviter.
MIBEKO_API_URL=http://localhost:8000/api/v1

# --- Mesure d'audience Umami (auto-hébergée, cookieless) — OPTIONNEL ---
# Si les deux variables sont définies, le site injecte le script Umami.
# Défaut absent → aucun script d'analytics chargé.
# IMPORTANT : PUBLIC_UMAMI_URL = ORIGINE DE BASE, SANS /script.js (le front
# l'ajoute lui-même). Ce sont des variables PUBLIC_* (lues au build/SSR).
#   PUBLIC_UMAMI_URL=https://stats.mibeko.fr
#   PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# --- Canal WhatsApp (encart de suivi) — OPTIONNEL ---
# Si définie, un encart « Suivez-nous sur WhatsApp » s'affiche. Défaut absent
# → rien n'est rendu (userAction : créer le canal et fournir l'URL).
#   PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/xxxxxxxx
